+namespace {
+
+constexpr float kRadiansToDegrees = 57.29577951308232f;
+constexpr float kLogIntervalSeconds = 5.0f;
+
+bool env_flag(const char *name)
+{
+    const char *value = getenv(name);
+    if (!value || !*value) return false;
+    return strcmp(value, "0") != 0 && strcmp(value, "off") != 0 && strcmp(value, "no") != 0;
+}
+
+void log_line(const char *fmt, ...)
+{
+    char buffer[512];
+    va_list args;
+    va_start(args, fmt);
+    vsnprintf(buffer, sizeof(buffer), fmt, args);
+    va_end(args);
+    fprintf(stderr, "[mc-camera] %s\n", buffer);
+    fflush(stderr);
+}
+
+// Same rules as CMinecraftSteve::FindBall: the level's own pickups start with
+// "P_" and never move, "Balloon" merely starts with "ball", and only the
+// interactive ball ("I_Ball...") is the one the player rolls.
+bool name_is_ball(const char *name)
+{
+    if (!name) return false;
+    if (name[0] == 'P' && name[1] == '_') return false;
+    for (const char *p = name; *p; ++p) {
+        if ((p[0] == 'b' || p[0] == 'B') && (p[1] == 'a' || p[1] == 'A') &&
+            (p[2] == 'l' || p[2] == 'L') && (p[3] == 'l' || p[3] == 'L')) {
+            return !(p[4] == 'o' || p[4] == 'O');
+        }
+    }
+    return false;
+}
+
+// A key pressed and released inside one frame is invisible to IsKeyDown():
+// SDL can deliver both events before the frame polls, which is why the panel
+// scans the same key buffer. One E press must be exactly one toggle.
+bool key_tapped(CKInputManager *input, CKDWORD key)
+{
+    if (!input) return false;
+    const int count = input->GetNumberOfKeyInBuffer();
+    CKDWORD buffered = 0;
+    for (int i = 0; i < count; ++i)
+    {
+        if (input->GetKeyFromBuffer(i, buffered) == KEY_PRESSED && buffered == key) return true;
+    }
+    return false;
+}
+
+// Seqlock reads on the client -> Ballance side of the object. The writer is the
+// Java mod, so the pair has to be an acquire load on both ends of the copy.
+#if defined(_WIN32)
+unsigned read_seq(const volatile uint32_t *value)
+{
+    return (unsigned)_InterlockedCompareExchange((volatile long *)value, 0, 0);
+}
+#else
+unsigned read_seq(const uint32_t *value)
+{
+    return __atomic_load_n(value, __ATOMIC_ACQUIRE);
+}
+#endif
+
+// --- pause gate state, process wide (there is one level at a time) ---
+unsigned g_PauseKeys = 0;
+float g_PauseSavedScale = 1.0f;
+
+float normalize(VxVector &v)
+{
+    const float length = sqrtf(v.x * v.x + v.y * v.y + v.z * v.z);
+    if (length > 1e-6f) {
+        v.x /= length;
+        v.y /= length;
+        v.z /= length;
+    }
+    return length;
+}
+
+} // namespace
+
+void CMinecraftPauseGate::Set(CKContext *context, unsigned key, bool paused)
+{
+    const unsigned before = g_PauseKeys;
+    if (paused)
+        g_PauseKeys |= key;
+    else
+        g_PauseKeys &= ~key;
+
+    CKTimeManager *timeManager =
+        context ? (CKTimeManager *)context->GetManagerByGuid(TIME_MANAGER_GUID) : nullptr;
+    if (!timeManager) return;
+
+    if (g_PauseKeys && !before)
+    {
+        g_PauseSavedScale = timeManager->GetTimeScaleFactor();
+        timeManager->SetTimeScaleFactor(0.0f);
+    }
+    else if (!g_PauseKeys && before)
+    {
+        timeManager->SetTimeScaleFactor(g_PauseSavedScale);
+    }
+    else if (g_PauseKeys && timeManager->GetTimeScaleFactor() != 0.0f)
+    {
+        // A level script is free to put the time scale back; while an overlay
+        // holds the gate, the overlay owns it.
+        timeManager->SetTimeScaleFactor(0.0f);
+    }
+}
+
+bool CMinecraftPauseGate::Held(unsigned key)
+{
+    return (g_PauseKeys & key) != 0u;
+}
+
+bool CMinecraftPauseGate::Paused()
+{
+    return g_PauseKeys != 0u;
+}
