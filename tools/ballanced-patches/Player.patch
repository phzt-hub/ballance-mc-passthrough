+void log_line(const char *fmt, ...)
+{
+    char buffer[512];
+    va_list args;
+    va_start(args, fmt);
+    vsnprintf(buffer, sizeof(buffer), fmt, args);
+    va_end(args);
+    fprintf(stderr, "[mc-panel] %s\n", buffer);
+    fflush(stderr);
+}
+
+bool env_flag(const char *name)
+{
+    const char *value = getenv(name);
+    if (!value || !*value) return false;
+    return strcmp(value, "0") != 0 && strcmp(value, "off") != 0 && strcmp(value, "false") != 0;
+}
+
+// The atlas is written as base64 so the header stays text: 9216 bytes of 8-bit
+// coverage is 12 KB as base64, which survives every tool that feels like
+// re-encoding a source file.
+int decode_base64(const char *text, unsigned char *out, int capacity)
+{
+    static const char kAlphabet[] =
+        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    int table[256];
+    for (int i = 0; i < 256; ++i) table[i] = -1;
+    for (int i = 0; i < 64; ++i) table[(unsigned char)kAlphabet[i]] = i;
+    int written = 0;
+    unsigned int accumulator = 0;
+    int bits = 0;
+    for (const char *p = text; *p; ++p)
+    {
+        const int value = table[(unsigned char)*p];
+        if (value < 0) continue;
+        accumulator = (accumulator << 6) | (unsigned int)value;
+        bits += 6;
+        if (bits >= 8)
+        {
+            bits -= 8;
+            if (written >= capacity) return written;
+            out[written++] = (unsigned char)((accumulator >> bits) & 0xFF);
+        }
+    }
+    return written;
+}
+
+// The glyph grid is 128x72; the texture is padded to 128x128 so both sides are
+// powers of two, which the rasterizer wants for mipmapping and wrapping.
+constexpr int kAtlasWidth = 128;
+constexpr int kAtlasHeight = 128;
+
+// A key pressed and released inside one frame is invisible to IsKeyDown(): SDL
+// can deliver both events before the frame polls. The key buffer keeps every
+// event of the frame, so the press is still readable there. Same helper as
+// MinecraftSteve.cpp.
+bool key_tapped(CKInputManager *input, CKDWORD key)
+{
+    const int count = input->GetNumberOfKeyInBuffer();
+    for (int i = 0; i < count; ++i)
+    {
+        CKDWORD buffered = 0;
+        if (input->GetKeyFromBuffer(i, buffered) == KEY_PRESSED && buffered == key) return true;
+    }
+    return false;
+}
+
+CKDWORD rgba(unsigned r, unsigned g, unsigned b, unsigned a)
+{
+    // Through VxColor so the byte order matches everything else the engine
+    // draws, rather than a hand-rolled shift that only looks right on one
+    // rasterizer.
+    return VxColor((float)r / 255.0f, (float)g / 255.0f, (float)b / 255.0f,
+                   (float)a / 255.0f)
+        .GetRGBA();
+}
