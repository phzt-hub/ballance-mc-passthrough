+// Relative mouse mode for the first-person rig, applied where the window lives.
+//
+// Why not in SdlInputManager: it tracks m_InputWindow from SetInputViewport, and
+// this player never calls that, so the manager has no window handle here
+// (BALLANCE_INPUT_DEBUG=1 shows input=0 on every event). SDL_SetWindowRelativeMouseMode
+// needs the real SDL_Window, and CGamePlayer owns it.
+//
+// Once captured, SDL warps the pointer back to the window centre after every
+// motion. That also removes the bogus first delta an uncaptured pointer
+// produces: SDL computed it against wherever the pointer had been, which
+// measured as a phantom "catch-up" turn in the opposite direction.
+static void ApplyRelativeMouseMode(SDL_Window *window, bool want)
+{
+    static bool applied = false;
+    if (!window || want == applied) return;
+    const bool ok = SDL_SetWindowRelativeMouseMode(window, want) != false;
+    if (ok) applied = want;
+    // Logged, not inferred: the pointer being released for a menu and the pointer
+    // never having been captured look identical in a screenshot.
+    // stderr, not CLogger: Debug lines are filtered at the default INFO level, and
+    // "was the pointer released?" has to be readable in every run.
+    fprintf(stderr, "[mc-steve] relative mouse mode %s (asked %s)%s\n",
+            applied ? "on" : "off", want ? "on" : "off", ok ? "" : " -- SDL refused");
+    fflush(stderr);
+}
+
 void CGamePlayer::Render()
 {
+    Poc1ApplyCameraPin(m_CKContext, m_RenderContext);
+    PocLevelStartAuto(m_CKContext);
+    PocLevelStopMenu(m_CKContext);
+    Poc1FrameLog(m_CKContext, m_RenderContext);
+    Poc1ForceCursor(m_CKContext);
+    Poc1InputLog(m_CKContext, m_RenderContext);
+    PocDumpScriptsAuto(m_CKContext);
+    PocDump2DAuto(m_CKContext);
+    PocDumpArraysAuto(m_CKContext);
+    static Uint64 lastTicks = 0;
+    const Uint64 nowTicks = SDL_GetTicks();
+    const float elapsed = lastTicks ? (float)(nowTicks - lastTicks) / 1000.0f : 0.0f;
