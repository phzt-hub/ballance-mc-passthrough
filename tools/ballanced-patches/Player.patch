+// PoC frame log: what the render context is actually looking at, per frame.
+//
+// Written for one question and nothing else: the level merged into base.cmo is
+// attached to the render context (IsObjectAttached says so) and yet a dumped
+// frame looks exactly like the composition's. So: which scene is current, which
+// camera is attached, where does the eye sit, and how many merged entities land
+// inside the view frustum? Public engine API only, on purpose -- no internal
+// headers, no build flags.
+//
+//   BALLANCE_POC_FRAMELOG=<n>   log frame 1..3 and then every n-th frame (n<2 -> 60)
+//
+// Build note: this file is concatenated *before* levelboot.cpp, because
+// LoadLevel() calls Poc1NoteMerged() for every object it merged in.
+
+#include <stdio.h>
+#include <stdlib.h>
+
+static XArray<CK_ID> s_PocMergedIds;
+
+static void Poc1NoteMerged(CKObject *object)
+{
+    if (object)
+        s_PocMergedIds.PushBack(object->GetID());
+}
+
+static bool Poc1IsMerged(CK_ID id)
+{
+    for (CK_ID *it = s_PocMergedIds.Begin(); it != s_PocMergedIds.End(); ++it)
+        if (*it == id)
+            return true;
+    return false;
+}
+
+// Virtools multiplies row vectors: p_clip = p_world * View * Projection.
+static void Poc1Transform(const VxMatrix &m, const float in[4], float out[4])
+{
+    for (int col = 0; col < 4; ++col)
+        out[col] = in[0] * m[0][col] + in[1] * m[1][col] + in[2] * m[2][col] + in[3] * m[3][col];
+}
+
+static bool Poc1InsideFrustum(const VxMatrix &view, const VxMatrix &projection, const VxVector &world,
+                              float ndc[3])
+{
+    const float p[4] = {world.x, world.y, world.z, 1.0f};
+    float viewPos[4];
+    float clip[4];
+    Poc1Transform(view, p, viewPos);
+    Poc1Transform(projection, viewPos, clip);
+    if (clip[3] <= 0.0001f)
+        return false;
+    ndc[0] = clip[0] / clip[3];
+    ndc[1] = clip[1] / clip[3];
+    ndc[2] = clip[2] / clip[3];
+    return ndc[0] > -1.0f && ndc[0] < 1.0f && ndc[1] > -1.0f && ndc[1] < 1.0f && ndc[2] > 0.0f && ndc[2] < 1.0f;
+}
+
+
+// The composition re-attaches its own camera (Cam_MenuLevel) every time it
+// launches a scene, so a one-off AttachViewpointToCamera() from LoadLevel() is
+// gone by the time the loop draws. Re-attach ours just before every draw, so
+// BALLANCE_POC_CAM actually decides what the frame shows.
+static void Poc1ApplyCameraPin(CKContext *context, CKRenderContext *rc)
+{
+    const char *spec = getenv("BALLANCE_POC_CAM");
+    if (!spec || !*spec || !context || !rc)
+        return;
+
+    CKCamera *camera = (CKCamera *)context->GetObjectByNameAndClass("PoCCamera", CKCID_CAMERA);
+    if (!camera)
+    {
+        camera = rc->GetAttachedCamera();
+        if (!camera)
+            return;
+    }
+
+    rc->AttachViewpointToCamera(camera);
+    rc->SetViewTransformationMatrix(camera->GetInverseWorldMatrix());
+    VxMatrix projection;
+    const float aspect = (rc->GetHeight() > 0) ? (float)rc->GetWidth() / (float)rc->GetHeight() : 4.0f / 3.0f;
+    projection.Perspective(camera->GetFov(), aspect, camera->GetFrontPlane(), camera->GetBackPlane());
+    rc->SetProjectionTransformationMatrix(projection);
+}
+
+
+// Where is the merged level, really? Entity origins are a poor guide: a map
+// mesh can sit at the origin and span hundreds of units. So project the world
+// bounding box of every merged 3D entity and report the ones that would cover
+// the most screen, plus the level's overall box -- that is what a camera has to
+// be aimed at.
+static void Poc1BBoxReport(CKContext *context, CKRenderContext *rc, int frame)
+{
+    if (!getenv("BALLANCE_POC_BBOX") || !context || !rc)
+        return;
+    if (frame != 60)
+        return;
+
+    const VxMatrix &view = rc->GetViewTransformationMatrix();
+    const VxMatrix &projection = rc->GetProjectionTransformationMatrix();
+    const float halfWidth = rc->GetWidth() * 0.5f;
+    const float halfHeight = rc->GetHeight() * 0.5f;
+
+    struct Entry { float area; VxVector center; VxVector size; char name[64]; };
+    XArray<Entry> entries;
+    VxVector lo(1e30f, 1e30f, 1e30f), hi(-1e30f, -1e30f, -1e30f);
+
+    const XObjectPointerArray entities = context->GetObjectListByType(CKCID_3DENTITY, TRUE);
+    for (CKObject **it = entities.Begin(); it != entities.End(); ++it)
+    {
+        CK3dEntity *entity = (CK3dEntity *)*it;
+        if (!entity || !Poc1IsMerged(entity->GetID()))
+            continue;
+
+        const VxBbox &box = entity->GetBoundingBox(FALSE);
+        if (!box.IsValid())
+            continue;
+
+        lo.x = box.Min.x < lo.x ? box.Min.x : lo.x;
+        lo.y = box.Min.y < lo.y ? box.Min.y : lo.y;
+        lo.z = box.Min.z < lo.z ? box.Min.z : lo.z;
+        hi.x = box.Max.x > hi.x ? box.Max.x : hi.x;
+        hi.y = box.Max.y > hi.y ? box.Max.y : hi.y;
+        hi.z = box.Max.z > hi.z ? box.Max.z : hi.z;
+
+        float sx0 = 1e30f, sy0 = 1e30f, sx1 = -1e30f, sy1 = -1e30f;
+        bool anyInside = false;
+        for (int corner = 0; corner < 8; ++corner)
+        {
+            const VxVector point((corner & 1) ? box.Max.x : box.Min.x,
+                                 (corner & 2) ? box.Max.y : box.Min.y,
+                                 (corner & 4) ? box.Max.z : box.Min.z);
+            float ndc[3];
+            if (!Poc1InsideFrustum(view, projection, point, ndc))
+                continue;
+            anyInside = true;
+            const float sx = ndc[0] * halfWidth;
+            const float sy = ndc[1] * halfHeight;
+            sx0 = sx < sx0 ? sx : sx0;
+            sx1 = sx > sx1 ? sx : sx1;
+            sy0 = sy < sy0 ? sy : sy0;
+            sy1 = sy > sy1 ? sy : sy1;
+        }
+        if (!anyInside)
+            continue;
+
+        Entry entry;
+        entry.area = (sx1 - sx0) * (sy1 - sy0);
+        entry.center = (box.Min + box.Max) * 0.5f;
+        entry.size = box.Max - box.Min;
+        snprintf(entry.name, sizeof(entry.name), "%s", entity->GetName() ? entity->GetName() : "(unnamed)");
+        entries.PushBack(entry);
+    }
+
+    CLogger::Get().Debug("PoC bbox: %d merged 3D entity/ies touch the frustum; level box min=(%.1f %.1f %.1f) max=(%.1f %.1f %.1f)",
+                         entries.Size(), lo.x, lo.y, lo.z, hi.x, hi.y, hi.z);
+
+    for (int i = 0; i < entries.Size() && i < 12; ++i)
+    {
+        for (int j = i + 1; j < entries.Size(); ++j)
+            if (entries[j].area > entries[i].area)
+            {
+                Entry swap = entries[i];
+                entries[i] = entries[j];
+                entries[j] = swap;
+            }
+        CLogger::Get().Debug("  bbox %-24s area=%8.0f px  center=(%.1f %.1f %.1f) size=(%.1f %.1f %.1f)",
+                             entries[i].name, entries[i].area,
+                             entries[i].center.x, entries[i].center.y, entries[i].center.z,
+                             entries[i].size.x, entries[i].size.y, entries[i].size.z);
+    }
+}
+
+static void Poc1FrameLog(CKContext *context, CKRenderContext *rc)
+{
+    const char *spec = getenv("BALLANCE_POC_FRAMELOG");
+    if (!spec || !*spec || !context || !rc)
+        return;
+
+    static int frame = 0;
+    ++frame;
+    const int period = atoi(spec) > 1 ? atoi(spec) : 60;
+    if (frame > 3 && (frame % period) != 0)
+        return;
+
+    CKScene *scene = context->GetCurrentScene();
+    CKCamera *camera = rc->GetAttachedCamera();
+    CK3dEntity *viewpoint = rc->GetViewpoint();
+    VxVector cameraPos(0, 0, 0);
+    VxVector viewpointPos(0, 0, 0);
+    if (camera)
+        camera->GetPosition(&cameraPos);
+    if (viewpoint)
+        viewpoint->GetPosition(&viewpointPos);
+
+    Poc1BBoxReport(context, rc, frame);
+
+    CLogger::Get().Debug("PoC frame %d: size %dx%d scene=%s camera=%s eye=(%.2f %.2f %.2f) viewpoint=(%.2f %.2f %.2f)",
+                         frame, rc->GetWidth(), rc->GetHeight(),
+                         scene && scene->GetName() ? scene->GetName() : "(none)",
+                         camera && camera->GetName() ? camera->GetName() : "(none)",
+                         cameraPos.x, cameraPos.y, cameraPos.z,
+                         viewpointPos.x, viewpointPos.y, viewpointPos.z);
+
+    const VxMatrix &view = rc->GetViewTransformationMatrix();
+    const VxMatrix &projection = rc->GetProjectionTransformationMatrix();
+
+    const XObjectPointerArray entities = context->GetObjectListByType(CKCID_3DENTITY, TRUE);
+    int total = 0, visible = 0, attached = 0, inside = 0;
+    int merged3d = 0, mergedVisible = 0, mergedAttached = 0, mergedInside = 0, mergedInScene = 0;
+    int logged = 0;
+    VxVector lo(1e30f, 1e30f, 1e30f);
+    VxVector hi(-1e30f, -1e30f, -1e30f);
+
+    for (CKObject **it = entities.Begin(); it != entities.End(); ++it)
+    {
+        CK3dEntity *entity = (CK3dEntity *)*it;
+        if (!entity)
+            continue;
+
+        const bool merged = Poc1IsMerged(entity->GetID());
+        const VxVector &world = entity->GetWorldMatrix()[3];
+        const bool shown = entity->IsVisible();
+        const bool bound = rc->IsObjectAttached(entity) != FALSE;
+        float ndc[3];
+        const bool inView = Poc1InsideFrustum(view, projection, world, ndc);
+
+        ++total;
+        if (shown) ++visible;
+        if (bound) ++attached;
+        if (inView) ++inside;
+
+        if (merged)
+        {
+            ++merged3d;
+            if (shown) ++mergedVisible;
+            if (bound) ++mergedAttached;
+            if (inView) ++mergedInside;
+            if (scene && entity->IsInScene(scene)) ++mergedInScene;
+            lo.x = world.x < lo.x ? world.x : lo.x;
+            lo.y = world.y < lo.y ? world.y : lo.y;
+            lo.z = world.z < lo.z ? world.z : lo.z;
+            hi.x = world.x > hi.x ? world.x : hi.x;
+            hi.y = world.y > hi.y ? world.y : hi.y;
+            hi.z = world.z > hi.z ? world.z : hi.z;
+
+            if (logged < 12)
+            {
+                CLogger::Get().Debug("  merged %s cid=%d pos=(%.2f %.2f %.2f) visible=%d attached=%d inScene=%d ndc=(%.2f %.2f %.2f) in=%d",
+                                     entity->GetName() ? entity->GetName() : "(unnamed)", entity->GetClassID(),
+                                     world.x, world.y, world.z, (int)shown, (int)bound,
+                                     scene ? (int)entity->IsInScene(scene) : -1,
+                                     ndc[0], ndc[1], ndc[2], (int)inView);
+                ++logged;
+            }
+        }
+    }
+
+    CLogger::Get().Debug("PoC frame %d: 3d total=%d visible=%d attached=%d inFrustum=%d | merged 3d=%d visible=%d attached=%d inScene=%d inFrustum=%d",
+                         frame, total, visible, attached, inside,
+                         merged3d, mergedVisible, mergedAttached, mergedInScene, mergedInside);
+    if (merged3d > 0)
+        CLogger::Get().Debug("PoC frame %d: merged bounds min=(%.2f %.2f %.2f) max=(%.2f %.2f %.2f)",
+                             frame, lo.x, lo.y, lo.z, hi.x, hi.y, hi.z);
+}
+
+// Input probe: does the X pointer reach the game at all? The menu is driven by
+// TT PushButton2, which needs (a) the mouse position the engine reports and
+// (b) the left button going down while the cursor is over the button sprite.
+// Neither is visible from outside, so log both.
+//
+//   BALLANCE_POC_INPUTLOG=<n>   every n-th render call (n<1 -> 30)
+static void Poc1InputLog(CKContext *ctx, CKRenderContext *rc)
+{
+    static int calls = 0;
+    ++calls;
+
+    const char *spec = getenv("BALLANCE_POC_INPUTLOG");
+    if (!spec || !ctx)
+        return;
+
+    int every = atoi(spec);
+    if (every < 1)
+        every = 30;
+    if (calls % every)
+        return;
+
+    CKInputManager *im = (CKInputManager *)ctx->GetManagerByGuid(INPUT_MANAGER_GUID);
+    if (!im)
+    {
+        CLogger::Get().Debug("PoC input %d: no input manager", calls);
+        return;
+    }
+
+    Vx2DVector rel, abs;
+    im->GetMousePosition(rel, FALSE);
+    im->GetMousePosition(abs, TRUE);
+
+    const char *picked = "(none)";
+    if (rc)
+    {
+        VxRect screen;
+        rc->GetWindowRect(screen, FALSE);
+        Vx2DVector p = rel;
+        p += screen.GetTopLeft();
+        CKObject *o = rc->Pick2D(p);
+        if (o && o->GetName())
+            picked = o->GetName();
+        else if (o)
+            picked = "(unnamed)";
+    }
+
+    CLogger::Get().Debug("PoC input %d: rel=(%.1f %.1f) abs=(%.1f %.1f) left=%d clicked=%d vis=%d pick2d=%s",
+                         calls, rel.x, rel.y, abs.x, abs.y,
+                         im->IsMouseButtonDown(CK_MOUSEBUTTON_LEFT),
+                         im->IsMouseClicked(CK_MOUSEBUTTON_LEFT),
+                         im->GetCursorVisibility(), picked);
+}
+
+// The menu's TT PushButton2 only reacts while the input manager says the cursor
+// is visible: ShowCursor(FALSE) is what the "Mouse Cursor" building block does
+// when it draws its own sprite cursor, and in the SDL port that sprite never
+// reaches the screen -- so the menu ends up with no cursor and no clicks.
+// BALLANCE_POC_CURSOR=1 puts the system cursor back.
+static void Poc1ForceCursor(CKContext *ctx)
+{
+    if (!ctx || !getenv("BALLANCE_POC_CURSOR"))
+        return;
+    CKInputManager *im = (CKInputManager *)ctx->GetManagerByGuid(INPUT_MANAGER_GUID);
+    if (im && !im->GetCursorVisibility())
+        im->ShowCursor(TRUE);
+}
+
+// PoC script dump: every behavioral object in the context, its scripts, and
+// the scripts' input/output pins.
+//
+// Written for one question: base.cmo already carries the gameplay scripts
+// (Gameplay_Ingame Script and friends), so a merged level does not lack a
+// script -- it lacks a trigger. This dump says which object owns each script
+// and which input pin has to be activated to start it.
+//
+//   BALLANCE_POC_DUMPSCRIPT=1   dump at LoadLevel() entry and at exit
+
+#include <string.h>
+
+static bool PocScriptWanted(const char *name)
+{
+    static const char *const kWords[] = {
+        "Gameplay", "Menu", "Load", "Level", "Start", "Play", "Ball", "Cam",
+        "Intro", "Sector", "Tutorial", "Events", "Refresh", "Pause", "Dead",
+        "End", "Highscore", "Unpause", "Exit", "reset", "next", "Default",
+        "Build", "Sound", "Ballsound"
+    };
+    if (!name)
+        return false;
+    for (size_t i = 0; i < sizeof(kWords) / sizeof(kWords[0]); ++i)
+        if (strstr(name, kWords[i]))
+            return true;
+    return false;
+}
+
+void PocDumpScripts(CKContext *context, const char *phase)
+{
+    if (!context || !getenv("BALLANCE_POC_DUMPSCRIPT"))
+        return;
+
+    const char *label = phase ? phase : "?";
+    CLogger::Get().Debug("PoC script dump (%s): begin", label);
+
+    const XObjectPointerArray all = context->GetObjectListByType(CKCID_BEOBJECT, TRUE);
+    int withScripts = 0;
+    int dumped = 0;
+    for (CKObject **it = all.Begin(); it != all.End(); ++it)
+    {
+        CKObject *obj = *it;
+        if (!obj)
+            continue;
+        CKBeObject *beo = (CKBeObject *)obj;
+        const int count = beo->GetScriptCount();
+        if (count <= 0)
+            continue;
+        ++withScripts;
+        const char *oname = obj->GetName() ? obj->GetName() : "(unnamed)";
+        const bool interestingOwner = PocScriptWanted(oname);
+        for (int s = 0; s < count; ++s)
+        {
+            CKBehavior *beh = beo->GetScript(s);
+            if (!beh)
+                continue;
+            const char *bname = beh->GetName() ? beh->GetName() : "(unnamed)";
+            if (!interestingOwner && !PocScriptWanted(bname) && dumped >= 250)
+                continue;
+            CLogger::Get().Debug("PoC script: owner='%s' cid=%d script='%s' cid=%d flags=0x%08x in=%d out=%d params=%d",
+                                 oname, obj->GetClassID(), bname, beh->GetClassID(),
+                                 (unsigned)beh->GetFlags(), beh->GetInputCount(),
+                                 beh->GetOutputCount(), beh->GetInputParameterCount());
+            for (int i = 0; i < beh->GetInputCount(); ++i)
+            {
+                CKBehaviorIO *io = beh->GetInput(i);
+                if (!io)
+                    continue;
+                CLogger::Get().Debug("    in[%d] '%s' active=%d", i,
+                                     io->GetName() ? io->GetName() : "(unnamed)", (int)io->IsActive());
+            }
+            for (int i = 0; i < beh->GetOutputCount(); ++i)
+            {
+                CKBehaviorIO *io = beh->GetOutput(i);
+                if (!io)
+                    continue;
+                CLogger::Get().Debug("    out[%d] '%s' active=%d", i,
+                                     io->GetName() ? io->GetName() : "(unnamed)", (int)io->IsActive());
+            }
+            for (int i = 0; i < beh->GetInputParameterCount(); ++i)
+            {
+                CKObject *p = beh->GetInputParameterObject(i);
+                if (!p)
+                    continue;
+                CLogger::Get().Debug("    param[%d] '%s' cid=%d", i,
+                                     p->GetName() ? p->GetName() : "(unnamed)", p->GetClassID());
+            }
+            ++dumped;
+        }
+    }
+    CLogger::Get().Debug("PoC script dump (%s): %d object(s) with scripts, %d script(s) dumped",
+                         label, withScripts, dumped);
+}
+
+// Frame-gated variant: base.cmo alone never calls LoadLevel(), so the menu
+// composition has to be sampled while it runs. Dumps once at frame
+// BALLANCE_POC_DUMPSCRIPT_FRAME (default 90, when the menu has finished
+// loading its NMOs).
+void PocDumpScriptsAuto(CKContext *context)
+{
+    if (!context || !getenv("BALLANCE_POC_DUMPSCRIPT"))
+        return;
+
+    static int frame = 0;
+    ++frame;
+    const char *spec = getenv("BALLANCE_POC_DUMPSCRIPT_FRAME");
+    const int target = spec ? atoi(spec) : 90;
+    if (frame != target)
+        return;
+
+    PocDumpScripts(context, "auto");
+}
+
+// Dump the 2D layer (menu buttons, labels) so a headless run can find where the
+// "Start" button is and click it with xdotool.
+//
+// Why this matters: the Ballance menu is a 3D scene with a rotating camera and a
+// 2D interface on top. Nothing in the .cmo starts a level by itself -- a click on
+// the menu does. Without the click the composition just spins forever, which is
+// exactly what every --level run so far showed.
+//
+//   BALLANCE_POC_DUMP2D=1            dump once
+//   BALLANCE_POC_DUMP2D_FRAME=n      at render call n (default 200)
+//   BALLANCE_POC_DUMP2D_ALL=1        include hidden entities (default: only visible)
+
+static void PocDump2DAuto(CKContext *ctx)
+{
+    static int calls = 0;
+
+    ++calls;
+    if (!ctx || !getenv("BALLANCE_POC_DUMP2D"))
+        return;
+
+    // Frame list, so one run can show the menu before and after a click:
+    // BALLANCE_POC_DUMP2D_FRAME=200,600,900
+    const char *frameSpec = getenv("BALLANCE_POC_DUMP2D_FRAME");
+    bool wanted = false;
+    if (!frameSpec || !*frameSpec)
+    {
+        wanted = (calls >= 200);
+    }
+    else
+    {
+        const char *p = frameSpec;
+        while (*p)
+        {
+            while (*p == ',' || *p == ' ')
+                ++p;
+            if (!*p)
+                break;
+            char *end = NULL;
+            const long v = strtol(p, &end, 10);
+            if (end == p)
+                break;
+            if (v == calls)
+                wanted = true;
+            p = end;
+            if (calls > v && *p != ',')
+                break;
+        }
+    }
+    if (!wanted)
+        return;
+
+    const bool dumpAll = getenv("BALLANCE_POC_DUMP2D_ALL") != NULL;
+
+    const XObjectPointerArray list = ctx->GetObjectListByType(CKCID_2DENTITY, TRUE);
+    int shown = 0;
+    CLogger::Get().Debug("PoC 2d dump at render call %d: %d 2d object(s)%s",
+                         calls, list.Size(), dumpAll ? " (including hidden)" : "");
+    for (CKObject **it = list.Begin(); it != list.End(); ++it)
+    {
+        CK2dEntity *ent = (CK2dEntity *)*it;
+        if (!ent)
+            continue;
+        if (!dumpAll && !ent->IsVisible())
+            continue;
+
+        Vx2DVector pos, size, hpos, hsize;
+        ent->GetPosition(pos, FALSE, NULL);
+        ent->GetSize(size, FALSE);
+        ent->GetPosition(hpos, TRUE, NULL);
+        ent->GetSize(hsize, TRUE);
+
+        const char *text = "";
+        if (ent->GetClassID() == CKCID_SPRITETEXT)
+        {
+            CKSTRING t = ((CKSpriteText *)ent)->GetText();
+            text = (t && *t) ? t : "";
+        }
+
+        CLogger::Get().Debug("PoC 2d: id=%d cid=%d name='%s' text='%s' vis=%d z=%d pos=(%.1f %.1f) size=(%.1f %.1f) hom=(%.4f %.4f)%s%.4f %.4f)",
+                             ent->GetID(), (int)ent->GetClassID(),
+                             ent->GetName() ? ent->GetName() : "(unnamed)", text,
+                             ent->IsVisible() ? 1 : 0, ent->GetZOrder(),
+                             pos.x, pos.y, size.x, size.y, hpos.x, hpos.y, "/(", hsize.x, hsize.y);
+        ++shown;
+    }
+    CLogger::Get().Debug("PoC 2d dump: %d object(s) listed", shown);
+}
+
+// BALLANCE_POC_DUMPARRAYS=<render call> -- dump every CKDataArray with its
+// column names and first rows. The menu decides which levels are selectable from
+// one of these, and a headless run has no other way to see it.
+static void PocDumpArraysAuto(CKContext *ctx)
+{
+    static int calls = 0;
+    ++calls;
+    const char *spec = getenv("BALLANCE_POC_DUMPARRAYS");
+    if (!ctx || !spec || !*spec)
+        return;
+    const int at = atoi(spec);
+    if (at > 0 && calls != at)
+        return;
+
+    const XObjectPointerArray list = ctx->GetObjectListByType(CKCID_DATAARRAY, TRUE);
+    CLogger::Get().Debug("PoC arrays: %d data array(s) at call %d", list.Size(), calls);
+    for (CKObject **it = list.Begin(); it != list.End(); ++it)
+    {
+        CKDataArray *arr = (CKDataArray *)*it;
+        if (!arr)
+            continue;
+        const int rows = arr->GetRowCount();
+        const int cols = arr->GetColumnCount();
+        CLogger::Get().Debug("PoC array '%s' rows=%d cols=%d",
+                             arr->GetName() ? arr->GetName() : "(unnamed)", rows, cols);
+        for (int c = 0; c < cols; ++c)
+            CLogger::Get().Debug("    col[%d] '%s' type=%d", c,
+                                 arr->GetColumnName(c) ? arr->GetColumnName(c) : "",
+                                 (int)arr->GetColumnType(c));
+        for (int r = 0; r < rows && r < 16; ++r)
+        {
+            char line[512] = {0};
+            for (int c = 0; c < cols; ++c)
+            {
+                char cell[64] = {0};
+                arr->GetElementStringValue(r, c, cell, sizeof(cell));
+                if (c)
+                    strncat(line, " | ", sizeof(line) - strlen(line) - 1);
+                strncat(line, cell, sizeof(line) - strlen(line) - 1);
+            }
+            CLogger::Get().Debug("    row[%d] %s", r, line);
+            for (int c = 0; c < cols; ++c)
+            {
+                if ((int)arr->GetColumnType(c) != CKARRAYTYPE_PARAMETER)
+                    continue;
+                CKObject *o = arr->GetElementObject(r, c);
+                if (!o)
+                    continue;
+                char text[64] = {0};
+                CKParameter *param = (CKParameter *)o;
+                if (CKIsChildClassOf(param, CKCID_PARAMETER) && param->GetStringValue(text, sizeof(text)))
+                    CLogger::Get().Debug("      param[%d,%d] '%s' = '%s'", r, c,
+                                         param->GetName() ? param->GetName() : "", text);
+            }
+        }
+    }
+}
+
+// BALLANCE_POC_START_LEVEL -- fire the level start-up scripts by hand.
+//
+// Merging a level's geometry only adds meshes to the scene: the scripts that
+// actually start a level sit on objects base.cmo already owns, and their Start
+// input is inactive. CKContext::Play() only calls CKLevel::ActivateAllScript()
+// when the context was reset, and an initial load is not a reset -- so nothing
+// ever fires them, and the menu camera keeps flying over the merged geometry.
+//
+// The chain mode fires only the level start-up scripts, leaving the composition
+// loaders (Loading_Manager, Object Load, Delete_*) alone: they would try to load
+// the level NMOs a second time.
+static bool PocLevelStartWanted(const char *name, const char *owner)
+{
+    static const char *const chain[] = {
+        "levelinit", "level_init", "gameplay_init", "balls_init", "init ballpieces",
+        "animtrafo_init", "menulevel_init", "default level", "gameplay_refresh",
+    };
+
+    for (size_t i = 0; i < sizeof(chain) / sizeof(chain[0]); ++i)
+    {
+        const char *patterns[2] = { name, owner };
+        for (int p = 0; p < 2; ++p)
+        {
+            if (!patterns[p])
+                continue;
+            const size_t len = strlen(patterns[p]);
+            const size_t plen = strlen(chain[i]);
+            for (size_t s = 0; s + plen <= len; ++s)
+            {
+                size_t k = 0;
+                while (k < plen &&
+                       tolower((unsigned char)patterns[p][s + k]) == (unsigned char)chain[i][k])
+                    ++k;
+                if (k == plen)
+                    return true;
+            }
+        }
+    }
+    return false;
+}
+
+static void PocLevelStartScripts(CKContext *ctx, CKLevel *level, const char *spec)
+{
+    if (!ctx || !level || !spec || !*spec || strcmp(spec, "0") == 0)
+        return;
+
+    const bool all = (strcmp(spec, "all") == 0);
+    CKScene *scene = ctx->GetCurrentScene();
+    CKBehaviorManager *bm = ctx->GetBehaviorManager();
+
+    int seen = 0, fired = 0;
+    const XObjectPointerArray beos = ctx->GetObjectListByType(CKCID_BEOBJECT, TRUE);
+    for (CKObject **it = beos.Begin(); it != beos.End(); ++it)
+    {
+        CKBeObject *beo = (CKBeObject *)*it;
+        if (!beo)
+            continue;
+
+        const int scripts = beo->GetScriptCount();
+        for (int i = 0; i < scripts; ++i)
+        {
+            CKBehavior *script = beo->GetScript(i);
+            if (!script || script->GetType() != CKBEHAVIORTYPE_SCRIPT)
+                continue;
+
+            const char *name = script->GetName();
+            const char *owner = beo->GetName();
+            ++seen;
+
+            const bool wanted = all || PocLevelStartWanted(name, owner);
+            CLogger::Get().Debug("PoC start-level: %s script '%s' on '%s'",
+                                 wanted ? "activate" : "skip",
+                                 name ? name : "(unnamed)", owner ? owner : "(unnamed)");
+            if (!wanted)
+                continue;
+
+            // Activate(TRUE, TRUE) == Reset() then the active flag; Reset() clears
+            // every IO and, for a script, re-arms the Start input (in[0]).
+            script->Activate(TRUE, TRUE);
+            if (bm)
+                bm->AddObject(beo);
+            if (scene && beo->IsInScene(scene))
+                scene->SetObjectFlags((CKSceneObject *)beo,
+                                      (CK_SCENEOBJECT_FLAGS)CK_SCENEOBJECT_ACTIVE);
+            ++fired;
+        }
+    }
+
+    CLogger::Get().Debug("PoC start-level '%s': %d of %d script(s) fired", spec, fired, seen);
+}
+
+
+// The menu owns the camera: its scripts re-attach Cam_MenuLevel every frame, so a
+// level that starts underneath them is still framed by the menu path. Switching
+// them off is what lets the gameplay camera show up. BALLANCE_POC_STOP_MENU=1.
+static void PocLevelStopMenu(CKContext *ctx);
+
+// Deferred pass. At LoadLevel() time the menu has only just started: the groups
+// that own the gameplay scripts (All_Gameplay, All_Balls, All_Levelinit, ...) are
+// pulled in by Loading_Manager over the next second, so a chain fired right after
+// the merge sees 9 scripts at most. Fire the chain once more when the menu has
+// settled -- BALLANCE_POC_START_FRAME (default 120) render calls after start.
+static void PocLevelStartAuto(CKContext *ctx)
+{
+    static int calls = 0;
+    static bool done = false;
+
+    ++calls;
+    if (done || !ctx)
+        return;
+
+    const char *spec = getenv("BALLANCE_POC_START_LEVEL");
+    if (!spec || !*spec || strcmp(spec, "0") == 0)
+        return;
+
+    const char *frameSpec = getenv("BALLANCE_POC_START_FRAME");
+    const int startFrame = (frameSpec && *frameSpec) ? atoi(frameSpec) : 120;
+    if (calls < startFrame)
+        return;
+
+    CKLevel *level = ctx->GetCurrentLevel();
+    if (!level)
+        return;
+
+    CLogger::Get().Debug("PoC start-level: deferred pass at render call %d", calls);
+    PocLevelStartScripts(ctx, level, spec);
+    PocLevelStopMenu(ctx);
+    done = true;
+}
+
+static bool PocNameHas(const char *name, const char *needle)
+{
+    if (!name || !needle || !*needle)
+        return false;
+    const size_t len = strlen(name);
+    const size_t nlen = strlen(needle);
+    for (size_t s = 0; s + nlen <= len; ++s)
+    {
+        size_t k = 0;
+        while (k < nlen && tolower((unsigned char)name[s + k]) == tolower((unsigned char)needle[k]))
+            ++k;
+        if (k == nlen)
+            return true;
+    }
+    return false;
+}
+
+static void PocLevelStopMenu(CKContext *ctx)
+{
+    // Called every frame: latch only once something was actually stopped, so the
+    // very first frames (nothing loaded yet) do not consume the single attempt.
+    static bool latched = false;
+    if (latched || !ctx || !getenv("BALLANCE_POC_STOP_MENU"))
+        return;
+
+    CKBehaviorManager *bm = ctx->GetBehaviorManager();
+    int stopped = 0;
+    const XObjectPointerArray beos = ctx->GetObjectListByType(CKCID_BEOBJECT, TRUE);
+    for (CKObject **it = beos.Begin(); it != beos.End(); ++it)
+    {
+        CKBeObject *beo = (CKBeObject *)*it;
+        if (!beo)
+            continue;
+
+        const char *owner = beo->GetName();
+        const bool menuOwner = PocNameHas(owner, "menu");
+        const int scripts = beo->GetScriptCount();
+
+        for (int i = 0; i < scripts; ++i)
+        {
+            CKBehavior *script = beo->GetScript(i);
+            if (!script || script->GetType() != CKBEHAVIORTYPE_SCRIPT)
+                continue;
+            if (!menuOwner && !PocNameHas(script->GetName(), "menu"))
+                continue;
+            script->Activate(FALSE, FALSE);
+            ++stopped;
+            CLogger::Get().Debug("PoC stop-menu: stopped script '%s' on '%s'",
+                                 script->GetName() ? script->GetName() : "(unnamed)",
+                                 owner ? owner : "(unnamed)");
+            if (bm)
+                bm->RemoveObjectNextFrame(beo);
+        }
+    }
+
+    if (stopped > 0)
+    {
+        latched = true;
+        CLogger::Get().Debug("PoC stop-menu: %d menu script(s) stopped", stopped);
+    }
+}
+
+bool CGamePlayer::LoadLevel(const char *filename)
+{
+    if (!filename || (*filename) == '\0')
+        return false;
+
+    if (!m_CKContext)
+    {
+        CLogger::Get().Error("CKContext is not initialized!");
+        return false;
+    }
+
+    CKPathManager *pm = m_CKContext->GetPathManager();
+    if (!pm)
+    {
+        CLogger::Get().Error("Failed to get CKPathManager!");
+        return false;
+    }
+
+    CKLevel *level = m_CKContext->GetCurrentLevel();
+    if (!level)
+    {
+        CLogger::Get().Error("No current level to merge into!");
+        return false;
+    }
+
+    CKScene *scene = m_CKContext->GetCurrentScene();
+
+    PocDumpScripts(m_CKContext, "entry");
+
+    // Snapshot of what the composition already owns. The PoC hides it so a dumped
+    // frame shows the level file alone instead of the menu drawn on top of it.
+    XObjectPointerArray preexisting;
+    {
+        const XObjectPointerArray all = m_CKContext->GetObjectListByType(CKCID_BEOBJECT, TRUE);
+        for (CKObject **it = all.Begin(); it != all.End(); ++it)
+            preexisting.PushBack(*it);
+    }
+
+    const int before = m_CKContext->GetObjectCount();
+
+    // Files to merge. A level .NMO carries only geometry: the level object, the
+    // managers and the gameplay scripts live in base.cmo, and the gameplay logic
+    // itself lives in Gameplay.nmo -- so merging the level geometry alone never
+    // starts a level. BALLANCE_POC_NMO names the support NMOs (Levelinit / Gameplay
+    // / Camera / Intro) to merge alongside the level, comma separated.
+    char extraSpec[4096];
+    extraSpec[0] = 0;
+    const char *envExtra = getenv("BALLANCE_POC_NMO");
+    if (envExtra && *envExtra)
+    {
+        strncpy(extraSpec, envExtra, sizeof(extraSpec) - 1);
+        extraSpec[sizeof(extraSpec) - 1] = 0;
+    }
+
+    char fileNames[16][2048];
+    int fileCount = 0;
+    fileNames[fileCount][0] = 0;
+    strncpy(fileNames[fileCount], filename, sizeof(fileNames[0]) - 1);
+    fileNames[fileCount][sizeof(fileNames[0]) - 1] = 0;
+    ++fileCount;
+
+    char *segment = extraSpec;
+    while (*segment && fileCount < 16)
+    {
+        char *comma = strchr(segment, ',');
+        if (comma) *comma = 0;
+        size_t len = strlen(segment);
+        while (len > 0 && (segment[len - 1] == ' ' || segment[len - 1] == '\t' ||
+                           segment[len - 1] == '\r' || segment[len - 1] == '\n'))
+            segment[--len] = 0;
+        size_t start = 0;
+        while (segment[start] == ' ' || segment[start] == '\t') ++start;
+        if (segment[start])
+        {
+            strncpy(fileNames[fileCount], segment + start, sizeof(fileNames[0]) - 1);
+            fileNames[fileCount][sizeof(fileNames[0]) - 1] = 0;
+            ++fileCount;
+        }
+        if (!comma) break;
+        segment = comma + 1;
+    }
+
+    int attached = 0;
+    int named = 0;
+    int mergedFiles = 0;
+
+    for (int f = 0; f < fileCount; ++f)
+    {
+        XString resolvedFile = fileNames[f];
+        if (pm->ResolveFileName(resolvedFile, DATA_PATH_IDX) != CK_OK)
+        {
+            if (f == 0)
+            {
+                CLogger::Get().Error("Failed to resolve level file %s", fileNames[f]);
+                return false;
+            }
+            CLogger::Get().Warn("PoC could not resolve NMO '%s' (skipped)", fileNames[f]);
+            continue;
+        }
+
+        CKObjectArray *array = CreateCKObjectArray();
+        if (!array)
+        {
+            CLogger::Get().Error("Failed to create CKObjectArray!");
+            return false;
+        }
+
+        // A Ballance level .NMO carries no CKLevel of its own: the level object, the
+        // managers and the gameplay scripts all live in base.cmo, and the original
+        // player merges a level into that composition. So the context is not reset.
+        CKERROR res = m_CKContext->Load(resolvedFile.Str(), array,
+                                        (CK_LOAD_FLAGS)(CK_LOAD_DEFAULT | CK_LOAD_CHECKDEPENDENCIES));
+        if (res != CK_OK)
+        {
+            CLogger::Get().Error("Failed to load NMO '%s': 0x%08x (skipped)", resolvedFile.CStr(), res);
+            DeleteCKObjectArray(array);
+            if (f == 0)
+                return false;
+            continue;
+        }
+
+        int fileAttached = 0;
+        for (array->Reset(); !array->EndOfList(); array->Next())
+        {
+            CKObject *obj = array->GetData(m_CKContext);
+            if (!obj)
+                continue;
+
+            if (!CKIsChildClassOf(obj, CKCID_BEOBJECT))
+                continue;
+
+            level->AddObject(obj);
+            if (scene && CKIsChildClassOf(obj, CKCID_SCENEOBJECT))
+                scene->AddObject((CKSceneObject *)obj);
+            // CKScene::Init() registers the scene's render objects with the render
+            // contexts only when a scene is launched, and the scene we merged into was
+            // launched long before these objects existed -- so register them by hand.
+            if (CKIsChildClassOf(obj, CKCID_RENDEROBJECT))
+                m_RenderContext->AddObjectWithHierarchy((CKRenderObject *)obj);
+            Poc1NoteMerged(obj);
+            ++attached;
+            ++fileAttached;
+
+            if (named < 8 && obj->GetName())
+            {
+                const char *vis = "?";
+                if (CKIsChildClassOf(obj, CKCID_3DENTITY))
+                    vis = ((CK3dEntity *)obj)->IsVisible() ? "visible" : "hidden";
+                else if (CKIsChildClassOf(obj, CKCID_2DENTITY))
+                    vis = ((CK2dEntity *)obj)->IsVisible() ? "visible" : "hidden";
+                CLogger::Get().Debug("  level object: %s (cid %d, %s, attached=%d)", obj->GetName(), obj->GetClassID(), vis,
+                                     CKIsChildClassOf(obj, CKCID_RENDEROBJECT) ? (int)m_RenderContext->IsObjectAttached((CKRenderObject *)obj) : -1);
+                ++named;
+            }
+        }
+        DeleteCKObjectArray(array);
+        ++mergedFiles;
+
+        CLogger::Get().Debug("Merged '%s': %d object(s)", resolvedFile.CStr(), fileAttached);
+    }
+
+    CLogger::Get().Debug("Merged %d NMO file(s) into level '%s': %d object(s), context %d -> %d object(s), scene %s",
+                         mergedFiles,
+                         level->GetName() ? level->GetName() : "(unnamed)",
+                         attached, before, m_CKContext->GetObjectCount(),
+                         scene ? "present" : "absent");
+
+    // Re-launching is what registers the merged objects with the render context
+    // (CKScene::Init -> CKRenderContext::AddObject) and activates their scripts;
+    // adding them to the level alone is not enough to get them drawn.
+    level->LaunchScene(NULL);
+
+    // LaunchScene() calls CKBehaviorManager::RemoveAllObjects(), so the scripts
+    // have to be fired after it, never before.
+    PocLevelStartScripts(m_CKContext, level, getenv("BALLANCE_POC_START_LEVEL"));
+
+    PocDumpScripts(m_CKContext, "exit");
+
+    const CKBOOL isolate = getenv("BALLANCE_POC_ISOLATE") != NULL;
+    if (isolate)
+    {
+        int hidden = 0;
+        for (CKObject **it = preexisting.Begin(); it != preexisting.End(); ++it)
+        {
+            CKObject *obj = *it;
+            if (!obj || obj == level)
+                continue;
+            if (CKIsChildClassOf(obj, CKCID_3DENTITY))
+                ((CK3dEntity *)obj)->Show(CKHIDE);
+            else if (CKIsChildClassOf(obj, CKCID_2DENTITY))
+                ((CK2dEntity *)obj)->Show(CKHIDE);
+            ++hidden;
+        }
+        CLogger::Get().Debug("PoC isolate: hid %d composition object(s); the level scripts may still drive the eye", hidden);
+    }
+
+    const char *camSpec = getenv("BALLANCE_POC_CAM");
+    if (camSpec)
+    {
+        float px = 0, py = 0, pz = 0, tx = 0, ty = 0, tz = 0;
+        if (sscanf(camSpec, "%f,%f,%f,%f,%f,%f", &px, &py, &pz, &tx, &ty, &tz) == 6)
+        {
+            // The Ballance compositions carry no CKCamera object (their scripts set
+            // the eye through the render context), so create one when there is none.
+            const XObjectPointerArray cams = m_CKContext->GetObjectListByType(CKCID_CAMERA, TRUE);
+            const bool created = cams.Size() == 0;
+            CKCamera *cam = created ? (CKCamera *)m_CKContext->CreateObject(CKCID_CAMERA, "PoCCamera")
+                                    : (CKCamera *)cams[0];
+            if (cam)
+            {
+                if (created)
+                    level->AddObject(cam);
+
+                cam->SetPosition3f(px, py, pz);
+                VxVector target(tx, ty, tz);
+                cam->LookAt(&target);
+                cam->SetFov(1.1f);
+                cam->SetFrontPlane(1.0f);
+                cam->SetBackPlane(20000.0f);
+                m_RenderContext->AttachViewpointToCamera(cam);
+
+                m_RenderContext->SetViewTransformationMatrix(cam->GetInverseWorldMatrix());
+                VxMatrix projection;
+                const float aspect = (m_RenderContext->GetHeight() > 0)
+                                         ? (float)m_RenderContext->GetWidth() / (float)m_RenderContext->GetHeight()
+                                         : 4.0f / 3.0f;
+                projection.Perspective(1.1f, aspect, 1.0f, 20000.0f);
+                m_RenderContext->SetProjectionTransformationMatrix(projection);
+
+                const VxMatrix &view = cam->GetInverseWorldMatrix();
+                for (int row = 0; row < 4; ++row)
+                    CLogger::Get().Debug("PoC view row %d: %g %g %g %g", row,
+                                         view[row][0], view[row][1], view[row][2], view[row][3]);
+
+                CLogger::Get().Debug("PoC camera%s: pos(%.1f %.1f %.1f) -> target(%.1f %.1f %.1f)",
+                                     created ? " (created)" : "", px, py, pz, tx, ty, tz);
+            }
+            else
+            {
+                CLogger::Get().Warn("PoC camera requested but no camera could be created");
+            }
+        }
+    }
+
+    m_RenderContext->Render();
+
+    return true;
+}
