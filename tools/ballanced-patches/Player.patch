+#ifndef PLAYER_MINECRAFTSTEVE_H
+#define PLAYER_MINECRAFTSTEVE_H
+
+#include "CKAll.h"
+
+#include <map>
+
+class CMinecraftSettings;
+
+// Puts Minecraft's Steve *inside* the Ballance world.
+//
+// The 2026-11-05 verdict was that the M0/M0b compositing pipeline had the
+// direction backwards: it painted a whole Minecraft frame over the Ballance
+// scene, so the world on screen was Minecraft's. What was wanted is the other
+// way round -- the Ballance world stays the world, and Steve stands in it.
+//
+// So this builds a plain CK2 mesh (six boxes on the classic 64x32 skin atlas),
+// gives it to a CK3dEntity, and drops that entity into the current scene. It is
+// therefore depth tested, lit and fogged by the game's own 3D pass: the pillars
+// occlude Steve exactly as they occlude the track. No shared memory, no
+// reprojection, no rasterizer hooks.
+//
+// Environment:
+//   BALLANCE_MC_STEVE=1        enable (default off)
+//   BALLANCE_MC_STEVE_POS=x,y,z  fixed feet position in Ballance units
+//   BALLANCE_MC_STEVE_BALL=0   do not follow the ball entity, stay at POS
+//   BALLANCE_MC_STEVE_YAW=deg  fixed yaw, overrides the ball heading
+//   BALLANCE_MC_STEVE_SCALE=f  Ballance units per model unit (default 1)
+//   BALLANCE_MC_STEVE_FP=1     park the camera at Steve's eyes (third person
+//                               shows the ball and no body; first person hides
+//                               the ball and shows the arm)
+//   BALLANCE_MC_STEVE_VIEW=3p|fp  start in this view, and keep the rig running
+//                               even with the body off (F5 flips it live)
+//   BALLANCE_MC_STEVE_LOOK=0   ignore the mouse (look control is on by default)
+//   BALLANCE_MC_STEVE_SENS=f   radians of yaw/pitch per mouse pixel (default 0.0025)
+//   BALLANCE_MC_STEVE_MOUSE=0  do not capture the pointer (look still reads deltas)
+//   BALLANCE_MC_STEVE_MENU=0   keep the pointer captured while a menu is up
+//                               (Escape would then no longer release it)
+//   BALLANCE_MC_STEVE_MENU_TEST=<file>  test hook: '0' hides the game cursor,
+//                               '1' shows it -- the same call the game's own
+//                               Mouse Cursor building block makes, so the menu
+//                               gate can be exercised where Ballance's pause
+//                               menu never opens (see tools/steve/menu_shots.sh)
+//   BALLANCE_MC_STEVE_BODY=0   body keeps the head's yaw instead of the heading
+//   BALLANCE_MC_STEVE_TURN=f   max body turn rate, degrees per second (default 720)
+//   BALLANCE_MC_STEVE_LEVEL=0/1  force "a menu is up" / "a level is running"
+//                               (default: read the attached camera's name; the
+//                               avatar is hidden and the mouse left alone
+//                               whenever it is not an in-game camera)
+//   BALLANCE_MC_STEVE_DEBUG=1  once a second, log what it found and where it is
+class CMinecraftSteve {
+public:
+    CMinecraftSteve();
+    ~CMinecraftSteve();
+
+    // Everything happens on the render thread, once per drawn frame.
+    void Frame(CKContext *context, CKRenderContext *renderContext, float deltaSeconds);
+    void Shutdown(CKContext *context);
+
+    bool Enabled() const { return m_Enabled; }
+
+    // Wired by the player: the user-facing options come from Minecraft.ini with
+    // the environment merged over it, so the settings panel can change them while
+    // the game runs. Without this pointer Steve falls back to the environment
+    // alone, exactly as before the panel existed.
+    void SetSettings(const CMinecraftSettings *settings) { m_Settings = settings; }
+    void ApplySettings();
+
+    // The panel is up: it owns the pointer, so no look, and no capture.
+    void SetPanelOpen(bool open) { m_PanelOpen = open; }
+
+    // Why the gate is in here and not in the player: the player only ever
+    // released the pointer on focus loss. Ballance's own pause menu never
+    // touches player state (CKContext::Pause is called around fullscreen
+    // switches only), so "a menu is up" has to be read from the game -- see
+    // UpdateMenuState.
+    bool MenuUp() const { return m_MenuGate && m_MenuUp; }
+
+    // The HUD asks two questions of the rig: is the camera at his eyes right now
+    // (only then is a first-person arm the truth), and is he being drawn at all.
+    // The module now also runs with the body switched off, because the settings
+    // default is "no body, first person", so Enabled() alone would not answer
+    // either question.
+    bool FirstPersonActive() const { return m_Enabled && m_InLevel && m_FirstPerson; }
+    bool BodyDrawn() const { return m_DrawBody; }
+
+    // First person + look means the pointer has to be *captured*: an uncaptured
+    // pointer stops at the window edge, and so do the deltas (measured
+    // 2026-11-04: 640x480 window, 200px of travel bought 28.6 degrees and then
+    // nothing at all). The player owns the SDL_Window, so it asks instead of
+    // reaching for it here.
+    bool WantsRelativeMouse() const;
+
+private:
+    bool ReadEnvironment();
+    bool Build(CKContext *context);
+    void UpdatePlacement(CKContext *context, float deltaSeconds);
+    void FindBall(CKContext *context, float deltaSeconds);
+    void UpdateLook(CKContext *context);
+    void UpdateMenuState(CKContext *context);
+    void UpdateViewKey(CKContext *context);
+    void UpdateBallVisibility();
+    void UpdateLevelState(CKRenderContext *renderContext);
+    void Validate(CKContext *context);
+    void UpdateBodyYaw(const VxVector &target, float deltaSeconds);
+    void ApplyFirstPersonCamera(CKRenderContext *renderContext);
+    void ApplyOffsetCamera(CKRenderContext *renderContext);
+    void DebugLog(CKContext *context, float deltaSeconds);
+
+    bool m_Enabled;
+    bool m_Built;
+    bool m_FirstPerson;
+    bool m_UseFixedPosition;
+    bool m_FollowBall;
+    bool m_Debug;
+    bool m_YawGiven;
+    bool m_LogPending;
+    bool m_DebugTimerReady;
+    bool m_BuildFailed;
+    bool m_Hide;
+    bool m_DrawBody;
+    bool m_HideBall;
+    // -1 = follow the settings, 0 = third person, 1 = first person. F5 writes
+    // this and the panel's FirstPerson row clears it again, so whichever the
+    // player touched last wins without the two overwriting each other.
+    int m_ViewOverride;
+    bool m_ViewKeyHeld;
+    bool m_SettingsSeen;
+    bool m_SettingsFirstPerson;
+    // What UpdateBallVisibility last wrote, and to which ball. The level hides
+    // and shows the ball itself, so the decision is only written when it moves:
+    // showing it every frame would undo whatever the level's scripts decided.
+    CK3dEntity *m_BallVisibilityTarget;
+    bool m_BallHidden;
+    bool m_HasCamOffset;
+    bool m_Look;
+    bool m_MouseCapture;
+    bool m_MenuGate;
+    bool m_MenuUp;
+    bool m_BodyFacing;
+
+    VxVector m_CamOffset;
+
+    float m_Scale;
+    float m_FixedYaw;
+    VxVector m_FixedPosition;
+    float m_Yaw;
+    // Pitch is the second half of "the mouse turns the head": yaw alone can only
+    // pan. Radians, clamped to +-85 degrees, the default the Ballance community
+    // settled on for free look (360Mode = 0, see docs/free-camera.md).
+    float m_Pitch;
+    float m_LookSensitivity;
+
+    // Two headings, on purpose. m_Yaw is the head's: it is what the mouse
+    // writes and what the first-person camera uses. m_BodyYaw is the body's: it
+    // follows the direction the ball is actually rolling. With one shared
+    // angle, looking sideways while rolling would swing the whole model around,
+    // and the body would keep pointing where the camera points instead of where
+    // it is going.
+    float m_BodyYaw;
+    float m_TurnRate;
+    bool m_HasLastBallPosition;
+    VxVector m_LastBallPosition;
+    float m_BodySpeed;
+    float m_BodyHeading;
+
+    // Frame(s) of pointer motion to drop right after the pointer is recaptured:
+    // SDL warps it to the window centre on capture, and the first delta it
+    // reports can be measured against where the pointer used to be.
+    int m_SkipLookFrames;
+
+    // Read from the game once per frame, logged with the rest (see DebugLog):
+    // which of the two is the real "a menu is up" signal is a measurement, not
+    // a guess.
+    bool m_MenuCursor;
+    bool m_MenuPlaying;
+    // The cursor flag is only believed once the game has driven it at least once
+    // (see UpdateMenuState): a flag that has never moved means "nobody told us",
+    // which is not the same statement as "a menu is up".
+    bool m_CursorArmed;
+    // Escape is the game's own menu key, so it is also the release key: the
+    // player presses it to open the pause menu and again to resume, and that is
+    // exactly the state the pointer has to follow. Pressing a movement key while
+    // released means "back in the game" -- which covers resuming from the pause
+    // menu by clicking Resume instead of pressing Escape.
+    bool m_MenuKeyUp;
+    bool m_EscapeHeld;
+    bool m_MovementHeld;
+    // Aggregated every frame, logged and cleared once a second by DebugLog: the
+    // only way to tell "the mouse is not reaching us" from "the mouse moved 0".
+    float m_MouseSumX;
+    float m_MouseSumY;
+    int m_MouseFrames;
+    float m_LogTimer;
+    float m_BallScanTimer;
+    std::map<CK3dEntity *, VxVector> m_LastPositions;
+
+    CKMesh *m_Mesh;
+    CK3dEntity *m_Entity;
+    CK3dEntity *m_Ball;
+    CKCamera *m_Camera;
+    // The ids of the three above, kept next to the pointers. Loading a level
+    // destroys the objects the previous one brought in, so after a level swap
+    // the pointers refer to freed memory; comparing them with what the context
+    // answers for the id is the only test that does not dereference them.
+    CK_ID m_EntityId;
+    CK_ID m_BallId;
+    CK_ID m_CameraId;
+    CKScene *m_Scene;
+    // Whether the game currently has an in-game camera attached. In the menu
+    // Steve is hidden and the mouse is left to the menu (see UpdateLevelState).
+    bool m_InLevel;
+    const CMinecraftSettings *m_Settings;
+    bool m_PanelOpen;
+    bool m_EnvironmentRead;
+    // -1 = read the camera, 0/1 = BALLANCE_MC_STEVE_LEVEL forced it.
+    int m_LevelOverride;
+    bool m_AvatarShown;
+    CKTexture *m_Texture;
+    CKMaterial *m_Material;
+
+    // Half extent of the model in Ballance units, used to place the feet and
+    // to report a height that can be compared against the ball.
+    float m_Height;
+    float m_EyeHeight;
+};
+
+#endif // PLAYER_MINECRAFTSTEVE_H
diff --git a/src/MpCamera.h b/src/MpCamera.h
new file mode 100644
index 0000000..98c7dcb
--- /dev/null
+++ b/src/MpCamera.h
@@ -0,0 +1,120 @@
+#ifndef MPCAMERA_H
+#define MPCAMERA_H
+
+// Ballance -> Minecraft camera channel (milestone M1).
+//
+// The frame mailbox (mpframe.h, in tools/passthrough of ballance-mc-passthrough)
+// carries pixels one way, Minecraft -> Ballance. M1 needs the opposite direction:
+// the viewpoint the scene was just rendered from, plus where the player ball is,
+// so the Minecraft client can render its own world from that same viewpoint.
+//
+//   [ MpCameraHeader   4096 B ]    the camera, plus the input mirror (M1b)
+//     MpClientStatus  at 2048      written by Minecraft, read by this side
+//
+// The writer is this directory's MinecraftCameraSync.cpp, the reader is the Fabric
+// mod. Linux: POSIX shm object /dev/shm/<name>. Windows: memory-mapped file in
+// %LOCALAPPDATA%\\BallanceMcPassthrough\\<name>.dat -- the same transport split,
+// and the same reasons, as the frame mailbox.
+//
+// Ordering: seqlock. The writer fills the fields and then bumps Seq with release
+// semantics; the reader samples Seq with acquire semantics before and after
+// copying and retries when it moved. A torn sample is never consumed, and the
+// writer never blocks the render thread it is publishing from.
+//
+// Coordinates are Ballance world units (Virtools, row vectors, left handed,
+// +Z forward, +Y up). Converting to Minecraft blocks is the reader's job;
+// UnitsPerBlock says how many units make one block (docs/scale-calibration.md measured
+// the ball at 4.0 u across; the passthrough uses 5.0, i.e. the ball is 0.8 of a block).
+//
+// M1b (2026-11-06) added two things to the same object, both in the space the
+// version-1 payload left as Reserved:
+//
+//   * AimLift -- the number of radians the Minecraft camera is tilted up above
+//     the Ballance view direction. The passthrough overlays one image on the
+//     other, so the Minecraft crosshair used to sit exactly on the ball, and a
+//     block placed at the crosshair landed on the ball. Tilting the Minecraft
+//     camera (not the Ballance one) lifts the crosshair off the ball while the
+//     Ballance frame keeps the viewpoint it was rendered from. The panel row
+//     AimLift writes this number, so it is tunable while playing.
+//
+//   * the input mirror -- pointer position/buttons/wheel and the two keys the
+//     Minecraft client cannot receive on its own, because the Ballance window
+//     owns the keyboard. Minecraft publishes back whether the inventory it
+//     opened is still up (MpClientStatus.GuiOpen); that is what tells this side
+//     to freeze the level and hand the pointer over.
+//
+// Keep in sync with tools/passthrough/mpcamera.h (the tools-side mirror) and with
+// McCameraChannel.java (the reader, which hardcodes these offsets).
+
+#include <stdint.h>
+
+#define MPC_MAGIC 0x3143504Du // 'M''P''C''1' little endian
+#define MPC_VERSION 2u
+#define MPC_BYTES 4096u
+
+// Flags
+#define MPC_FLAG_VALID 0x1u      // Eye/Forward/Up/FovY are meaningful
+#define MPC_FLAG_BALL 0x2u       // Ball is meaningful
+#define MPC_FLAG_PAUSED 0x4u     // the level is not advancing
+
+// Pointer buttons, as published in InputButtons.
+#define MPC_BUTTON_LEFT 0x1u
+#define MPC_BUTTON_RIGHT 0x2u
+#define MPC_BUTTON_MIDDLE 0x4u
+
+typedef struct MpCameraHeader {
+    uint32_t Magic;         // MPC_MAGIC
+    uint32_t Version;       // MPC_VERSION
+    uint32_t Seq;           // seqlock counter, release-published last
+    uint32_t Flags;         // MPC_FLAG_*
+    uint32_t Width;         // Ballance render target, pixels
+    uint32_t Height;        // ditto
+    float Eye[3];           // camera position, units
+    float Forward[3];       // unit view direction, units
+    float Up[3];            // unit up vector, units
+    float FovY;             // vertical field of view, radians
+    float Aspect;           // Width / Height of the projection used
+    float Near;             // front plane, units
+    float Far;              // back plane, units
+    float Ball[3];          // player ball centre, units
+    float UnitsPerBlock;    // 5.0 = one block, drawn scale (the ball is 4.0 u across)
+    uint32_t Frame;         // Ballance frame counter
+    uint64_t TimeNs;        // CLOCK_MONOTONIC of the publish
+    // --- M1b. These sit where version 1 had Reserved[0..], so every offset
+    // above them is unchanged and an older reader simply ignores them.
+    float AimLift;          // radians the Minecraft camera is tilted up; 0 = on the ball
+    float MouseX;           // pointer in the Ballance window, 0..1, origin top left
+    float MouseY;
+    uint32_t InputButtons;  // MPC_BUTTON_*
+    int32_t Wheel;          // wheel notches accumulated since the writer started
+    uint32_t KeyE;          // monotonic press counters; the reader keeps its own copy
+    uint32_t KeyEsc;
+    uint32_t Reserved[22];  // keeps the struct well inside MPC_BYTES
+} MpCameraHeader;
+
+// Minecraft -> Ballance, at MPS_OFFSET in the same object. The camera channel
+// cannot carry this: it is written by the other process, and the reader of this
+// side needs to know whether the inventory is still up before it can decide to
+// freeze the level. Own seqlock: Magic is written once, Seq last.
+typedef struct MpClientStatus {
+    uint32_t Magic;         // MPS_MAGIC, written once the client is alive
+    uint32_t Seq;           // seqlock counter, release-published last
+    uint32_t GuiOpen;       // 1 while the passthrough inventory is on screen
+    uint32_t Ticks;         // client ticks since start
+    uint32_t KeyE;          // the press counters the client has acted on
+    uint32_t KeyEsc;
+    uint32_t GuiWidth;      // the inventory's coordinate space, GUI pixels
+    uint32_t GuiHeight;
+    uint32_t Reserved[8];
+} MpClientStatus;
+
+#define MPS_OFFSET 2048u
+#define MPS_MAGIC 0x3153504Du // 'M''P''S''1'
+
+#if defined(__cplusplus)
+static_assert(sizeof(MpCameraHeader) <= MPS_OFFSET, "MpCameraHeader must not reach MpClientStatus");
+static_assert(MPS_OFFSET + sizeof(MpClientStatus) <= MPC_BYTES,
+              "MpClientStatus must fit in MPC_BYTES");
+#endif
+
+#endif // MPCAMERA_H
