+CMinecraftCameraSync::CMinecraftCameraSync()
+{
+    m_Enabled = env_flag("BALLANCE_MC_CAMERA");
+}
+
+CMinecraftCameraSync::~CMinecraftCameraSync()
+{
+    Shutdown();
+}
+
+void CMinecraftCameraSync::Shutdown()
+{
+    Release();
+}
+
+void CMinecraftCameraSync::ResolvePath()
+{
+    const char *path = getenv("BALLANCE_MC_CAMERA_PATH");
+    if (path && *path) {
+        snprintf(m_Path, sizeof(m_Path), "%s", path);
+        m_ShmName[0] = '\0';
+        return;
+    }
+
+    const char *name = getenv("BALLANCE_MC_CAMERA_SHM");
+    if (!name || !*name) name = "ballance_mc_camera";
+
+#if defined(_WIN32)
+    const char *local = getenv("LOCALAPPDATA");
+    if (!local || !*local) local = ".";
+    char directory[512];
+    snprintf(directory, sizeof(directory), "%s\\BallanceMcPassthrough", local);
+    CreateDirectoryA(directory, nullptr);
+    snprintf(m_Path, sizeof(m_Path), "%s\\%s.dat", directory, name);
+    m_ShmName[0] = '\0';
+#else
+    // shm_open takes an object name, not a path; /dev/shm/<name> is only the
+    // filesystem view of it (the same split the frame mailbox documents).
+    if (name[0] == '/')
+        snprintf(m_ShmName, sizeof(m_ShmName), "%s", name);
+    else
+        snprintf(m_ShmName, sizeof(m_ShmName), "/%s", name);
+    snprintf(m_Path, sizeof(m_Path), "/dev/shm/%s", name);
+#endif
+}
+
+bool CMinecraftCameraSync::Initialise()
+{
+    m_Initialised = true;
+    if (!m_Enabled) return false;
+
+    ResolvePath();
+
+#if defined(_WIN32)
+    HANDLE file = CreateFileA(m_Path, GENERIC_READ | GENERIC_WRITE,
+                              FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_ALWAYS,
+                              FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE) {
+        log_line("cannot open %s (error %lu)", m_Path, GetLastError());
+        return false;
+    }
+    LARGE_INTEGER size;
+    size.QuadPart = MPC_BYTES;
+    if (!SetFilePointerEx(file, size, nullptr, FILE_BEGIN) || !SetEndOfFile(file)) {
+        log_line("cannot size %s (error %lu)", m_Path, GetLastError());
+        CloseHandle(file);
+        return false;
+    }
+    HANDLE section = CreateFileMappingA(file, nullptr, PAGE_READWRITE, 0, MPC_BYTES, nullptr);
+    if (!section) {
+        log_line("CreateFileMapping %s failed (error %lu)", m_Path, GetLastError());
+        CloseHandle(file);
+        return false;
+    }
+    void *base = MapViewOfFile(section, FILE_MAP_ALL_ACCESS, 0, 0, MPC_BYTES);
+    if (!base) {
+        log_line("MapViewOfFile %s failed (error %lu)", m_Path, GetLastError());
+        CloseHandle(section);
+        CloseHandle(file);
+        return false;
+    }
+    m_FileHandle = file;
+    m_Section = section;
+    m_Header = (MpCameraHeader *)base;
+    m_Status = (MpClientStatus *)((char *)base + MPS_OFFSET);
+#else
+    m_Fd = shm_open(m_ShmName, O_CREAT | O_RDWR, 0666);
+    if (m_Fd < 0) {
+        log_line("shm_open %s failed: %s", m_ShmName, strerror(errno));
+        return false;
+    }
+    struct stat info;
+    if (fstat(m_Fd, &info) != 0 || (size_t)info.st_size < MPC_BYTES) {
+        if (ftruncate(m_Fd, (off_t)MPC_BYTES) != 0) {
+            log_line("ftruncate %s failed: %s", m_Path, strerror(errno));
+            close(m_Fd);
+            m_Fd = -1;
+            return false;
+        }
+    }
+    void *base = mmap(nullptr, MPC_BYTES, PROT_READ | PROT_WRITE, MAP_SHARED, m_Fd, 0);
+    if (base == MAP_FAILED) {
+        log_line("mmap %s failed: %s", m_Path, strerror(errno));
+        close(m_Fd);
+        m_Fd = -1;
+        return false;
+    }
+    m_Header = (MpCameraHeader *)base;
+    m_Status = (MpClientStatus *)((char *)base + MPS_OFFSET);
+#endif
+
+    m_Header->Magic = MPC_MAGIC;
+    m_Header->Version = MPC_VERSION;
+    m_Seq = 0;
+    m_Mapped = true;
+    log_line("publishing to %s (%u bytes)", m_Path, (unsigned)MPC_BYTES);
+    return true;
+}
+
+void CMinecraftCameraSync::Release()
+{
+    if (!m_Mapped || !m_Header) {
+        m_Header = nullptr;
+        m_Status = nullptr;
+        return;
+    }
+    m_Header->Flags = 0;
+#if defined(_WIN32)
+    _InterlockedExchange((volatile long *)&m_Header->Seq, 0);
+#else
+    __atomic_store_n(&m_Header->Seq, 0u, __ATOMIC_RELEASE);
+#endif
+#if defined(_WIN32)
+    UnmapViewOfFile(m_Header);
+    if (m_Section) CloseHandle((HANDLE)m_Section);
+    if (m_FileHandle && m_FileHandle != INVALID_HANDLE_VALUE) CloseHandle((HANDLE)m_FileHandle);
+    m_Section = nullptr;
+    m_FileHandle = nullptr;
+#else
+    munmap(m_Header, MPC_BYTES);
+    if (m_Fd >= 0) close(m_Fd);
+    m_Fd = -1;
+#endif
+    m_Header = nullptr;
+    m_Status = nullptr;
+    m_Mapped = false;
+}
+
+bool CMinecraftCameraSync::BallAlive(CKContext *context)
+{
+    if (!context || !m_Ball || !m_BallId) return false;
+    return context->GetObject(m_BallId) == m_Ball;
+}
+
+void CMinecraftCameraSync::FindBall(CKContext *context)
+{
+    if (m_Ball && BallAlive(context)) return;
+    m_Ball = nullptr;
+    m_BallId = 0;
+    if (!context) return;
+
+    const XObjectPointerArray entities = context->GetObjectListByType(CKCID_3DENTITY, TRUE);
+    // More than one object looks like a ball, and which one is the player's
+    // depends on how the level was entered: the isolated harness (--level plus
+    // the start-up scripts) exposes the interactive I_Ball_*, while the real
+    // menu -> level flow exposes the rendered model (Ball_Wood / Ball_Stone /
+    // Ball_Paper) and leaves the other two parked at the origin. Rank them
+    // instead of hard-coding one name:
+    //   * I_Ball_* is the interactive ball and always wins;
+    //   * an exact Ball_Wood/Stone/Paper with a 4 x 4 x 4 box is the visible model;
+    //   * among those, the one the camera is actually looking at wins, which is
+    //     what separates the ball from the decorative pickups parked at (0,0,0).
+    CK3dEntity *best = nullptr;
+    float bestScore = -1e30f;
+    for (CKObject **it = entities.Begin(); it != entities.End(); ++it) {
+        CK3dEntity *entity = (CK3dEntity *)*it;
+        if (!entity) continue;
+        const char *name = entity->GetName();
+        if (!name || !name_is_ball(name)) continue;
+        const VxBbox box = entity->GetBoundingBox(FALSE);
+        if (!box.IsValid()) continue;
+        const VxVector size = box.GetSize();
+        if (fabsf(size.x - 4.0f) > 1.0f || fabsf(size.z - 4.0f) > 1.0f) continue;
+
+        VxVector position(0.0f, 0.0f, 0.0f);
+        entity->GetPosition(&position);
+
+        float score = 0.0f;
+        if (strncmp(name, "I_Ball", 6) == 0) score += 1000.0f;
+        if (strcmp(name, "Ball_Wood") == 0 || strcmp(name, "Ball_Stone") == 0 ||
+            strcmp(name, "Ball_Paper") == 0)
+            score += 300.0f;
+        if (entity->IsVisible()) score += 50.0f;
+        if (fabsf(position.x) + fabsf(position.y) + fabsf(position.z) > 40.0f) score += 20.0f;
+        const VxVector delta = position - m_Eye;
+        const float along = delta.x * m_Forward.x + delta.y * m_Forward.y + delta.z * m_Forward.z;
+        if (along > 0.0f) {
+            const float dx = delta.x - m_Forward.x * along;
+            const float dy = delta.y - m_Forward.y * along;
+            const float dz = delta.z - m_Forward.z * along;
+            score -= 0.5f * sqrtf(dx * dx + dy * dy + dz * dz);
+        } else {
+            score -= 200.0f;
+        }
+        if (score > bestScore) {
+            bestScore = score;
+            best = entity;
+        }
+    }
+
+    if (!best) return;
+    m_Ball = best;
+    m_BallId = best->GetID();
+    log_line("following ball \"%s\" (score %.0f)", best->GetName(), bestScore);
+}
+
+void CMinecraftCameraSync::Publish(const MpCameraHeader &header)
+{
+    if (!m_Header) return;
+    const uint32_t seq = ++m_Seq;
+    m_Header->Magic = header.Magic;
+    m_Header->Version = header.Version;
+    m_Header->Flags = header.Flags;
+    m_Header->Width = header.Width;
+    m_Header->Height = header.Height;
+    memcpy(m_Header->Eye, header.Eye, sizeof(header.Eye));
+    memcpy(m_Header->Forward, header.Forward, sizeof(header.Forward));
+    memcpy(m_Header->Up, header.Up, sizeof(header.Up));
+    m_Header->FovY = header.FovY;
+    m_Header->Aspect = header.Aspect;
+    m_Header->Near = header.Near;
+    m_Header->Far = header.Far;
+    memcpy(m_Header->Ball, header.Ball, sizeof(header.Ball));
+    m_Header->UnitsPerBlock = header.UnitsPerBlock;
+    m_Header->Frame = header.Frame;
+    m_Header->TimeNs = header.TimeNs;
+    // M1b: the aim lift and the input mirror ride the same seqlock, so a reader
+    // never sees a pointer position from one frame next to a camera from another.
+    m_Header->AimLift = header.AimLift;
+    m_Header->MouseX = header.MouseX;
+    m_Header->MouseY = header.MouseY;
+    m_Header->InputButtons = header.InputButtons;
+    m_Header->Wheel = header.Wheel;
+    m_Header->KeyE = header.KeyE;
+    m_Header->KeyEsc = header.KeyEsc;
+    // The sequence store is the publication barrier: everything above has to be
+    // visible to a reader that acquires this value (see MpCamera.h).
+#if defined(_WIN32)
+    _InterlockedExchange((volatile long *)&m_Header->Seq, (long)seq);
+#else
+    __atomic_store_n(&m_Header->Seq, seq, __ATOMIC_RELEASE);
+#endif
+}
+
+float CMinecraftCameraSync::AimLiftRadians() const
+{
+    if (!m_Settings) return 0.0f;
+    const float degrees = m_Settings->GetFloat(eMcAimLift);
+    return degrees * (3.14159265358979323846f / 180.0f);
+}
+
+void CMinecraftCameraSync::PublishInput(CKContext *context, CKRenderContext *renderContext,
+                                        MpCameraHeader &header)
+{
+    // Neutral by default: the menu has no ball, and handing the pointer to
+    // Minecraft while the menu is up would open an inventory over the menu.
+    header.AimLift = AimLiftRadians();
+    header.MouseX = 0.5f;
+    header.MouseY = 0.5f;
+    header.InputButtons = 0u;
+    header.Wheel = m_Wheel;
+    header.KeyE = m_KeyE;
+    header.KeyEsc = m_KeyEsc;
+
+    CKInputManager *input = (CKInputManager *)context->GetManagerByGuid(INPUT_MANAGER_GUID);
+    if (!input) return;
+    if (!(header.Flags & MPC_FLAG_BALL)) return;
+    // The settings panel owns the pointer while it is open: forwarding E or a
+    // click to Minecraft there would open an inventory behind the panel.
+    if (CMinecraftPauseGate::Held(CMinecraftPauseGate::ePanel)) return;
+
+    const float width = (float)renderContext->GetWidth();
+    const float height = (float)renderContext->GetHeight();
+    Vx2DVector pointer;
+    input->GetMousePosition(pointer, FALSE);
+    if (width > 1.0f) header.MouseX = pointer.x / width;
+    if (height > 1.0f) header.MouseY = pointer.y / height;
+
+    if (input->IsMouseButtonDown(CK_MOUSEBUTTON_LEFT)) header.InputButtons |= MPC_BUTTON_LEFT;
+    if (input->IsMouseButtonDown(CK_MOUSEBUTTON_RIGHT)) header.InputButtons |= MPC_BUTTON_RIGHT;
+    if (input->IsMouseButtonDown(CK_MOUSEBUTTON_MIDDLE)) header.InputButtons |= MPC_BUTTON_MIDDLE;
+
+    // The wheel is a per-frame delta in Windows units (120 per notch) and this
+    // side runs faster than the client's 20 ticks a second, so it is summed here
+    // and published as a total: a frame the client never sampled loses nothing.
+    VxVector relative;
+    input->GetMouseRelativePosition(relative);
+    if (relative.z != 0.0f) m_Wheel += (int32_t)relative.z;
+    header.Wheel = m_Wheel;
+
+    // One press, one toggle: edge on the frame's key state, plus the buffer for
+    // the tap that started and ended between two frames.
+    const bool e = input->IsKeyDown(CKKEY_E) != FALSE || key_tapped(input, CKKEY_E);
+    if (e && !m_EDown) ++m_KeyE;
+    m_EDown = e;
+    const bool escape = input->IsKeyDown(CKKEY_ESCAPE) != FALSE || key_tapped(input, CKKEY_ESCAPE);
+    if (escape && !m_EscDown) ++m_KeyEsc;
+    m_EscDown = escape;
+    header.KeyE = m_KeyE;
+    header.KeyEsc = m_KeyEsc;
+}
+
+void CMinecraftCameraSync::SyncInventoryState(CKContext *context, CKInputManager *input)
+{
+    if (!m_Status) return;
+
+    bool guiOpen = false;
+    const unsigned before = read_seq(&m_Status->Seq);
+    if (before != 0u && m_Status->Magic == MPS_MAGIC)
+    {
+        const uint32_t open = m_Status->GuiOpen;
+        const unsigned after = read_seq(&m_Status->Seq);
+        guiOpen = (before == after) && open != 0u;
+    }
+
+    const bool wasOpen = m_InventoryOpen;
+    if (guiOpen != wasOpen)
+    {
+        m_InventoryOpen = guiOpen;
+        log_line("minecraft inventory %s", guiOpen ? "open -- level frozen, pointer handed over"
+                                                    : "closed -- level resumed");
+    }
+
+    // The level stands still while the inventory is up: the pointer is on loan to
+    // Minecraft, and a rolling ball would be gone before the block is picked.
+    CMinecraftPauseGate::Set(context, CMinecraftPauseGate::eInventory, guiOpen);
+    if (input)
+    {
+        // Only on the transition: the menu wants the cursor too, and re-hiding it
+        // every frame would take the menu's pointer away.
+        if (guiOpen) input->ShowCursor(TRUE);
+        else if (wasOpen && !CMinecraftPauseGate::Held(CMinecraftPauseGate::ePanel))
+            input->ShowCursor(FALSE);
+    }
+}
+
+void CMinecraftCameraSync::Frame(CKContext *context, CKRenderContext *renderContext, float deltaSeconds)
+{
+    if (!m_Initialised) {
+        if (!Initialise()) return;
+    }
+    if (!m_Enabled || !m_Mapped || !m_Header) return;
+    if (!context || !renderContext) return;
+
+    ++m_Frame;
+
+    MpCameraHeader header = {};
+    header.Magic = MPC_MAGIC;
+    header.Version = MPC_VERSION;
+    header.Width = (uint32_t)renderContext->GetWidth();
+    header.Height = (uint32_t)renderContext->GetHeight();
+    // The scale the passthrough draws with: one Minecraft block is five Ballance units.
+    // (docs/scale-calibration.md calibrates the ball at 4.0 u across; at 5 u per block the
+    // ball is 0.8 blocks, which is the ratio the user picked after seeing it on screen.)
+    header.UnitsPerBlock = 5.0f;
+    header.Frame = m_Frame;
+
+    // The attached camera is what the scene draws from, and its transform is
+    // current: level scripts move it before the frame is rendered.
+    CKCamera *camera = renderContext->GetAttachedCamera();
+    VxMatrix world;
+    bool haveWorld = false;
+    if (camera) {
+        world = camera->GetWorldMatrix();
+        haveWorld = true;
+        header.FovY = camera->GetFov();
+        header.Near = camera->GetFrontPlane();
+        header.Far = camera->GetBackPlane();
+    } else {
+        const VxMatrix &view = renderContext->GetViewTransformationMatrix();
+        Vx3DInverseMatrix(world, view);
+        haveWorld = true;
+        const VxMatrix &projection = renderContext->GetProjectionTransformationMatrix();
+        const float m11 = projection[1][1];
+        const float m00 = projection[0][0];
+        header.FovY = (m11 > 1e-6f) ? 2.0f * atanf(1.0f / m11) : 1.2217f;
+        header.Near = 0.5f;
+        header.Far = 20000.0f;
+        (void)m00;
+    }
+
+    if (haveWorld) {
+        VxVector eye(world[3][0], world[3][1], world[3][2]);
+        VxVector forward(world[2][0], world[2][1], world[2][2]);
+        VxVector up(world[1][0], world[1][1], world[1][2]);
+        normalize(forward);
+        normalize(up);
+        m_Eye = eye;
+        m_Forward = forward;
+        header.Eye[0] = eye.x;
+        header.Eye[1] = eye.y;
+        header.Eye[2] = eye.z;
+        header.Forward[0] = forward.x;
+        header.Forward[1] = forward.y;
+        header.Forward[2] = forward.z;
+        header.Up[0] = up.x;
+        header.Up[1] = up.y;
+        header.Up[2] = up.z;
+        header.Flags |= MPC_FLAG_VALID;
+    }
+
+    header.Aspect = (header.Height > 0)
+                        ? (float)header.Width / (float)header.Height
+                        : (header.FovY > 0.0f ? 4.0f / 3.0f : 1.0f);
+
+    FindBall(context);
+    if (m_Ball && BallAlive(context)) {
+        VxVector ball(0.0f, 0.0f, 0.0f);
+        m_Ball->GetPosition(&ball);
+        header.Ball[0] = ball.x;
+        header.Ball[1] = ball.y;
+        header.Ball[2] = ball.z;
+        header.Flags |= MPC_FLAG_BALL;
+    }
+
+    header.TimeNs = (uint64_t)std::chrono::duration_cast<std::chrono::nanoseconds>(
+                        std::chrono::steady_clock::now().time_since_epoch())
+                        .count();
+
+    // M1b: what the pointer and the two forwarded keys are doing this frame. Has
+    // to run before Publish, because it fills the same seqlock payload.
+    PublishInput(context, renderContext, header);
+
+    Publish(header);
+
+    // ... and what Minecraft says it is doing with them. Runs after Publish so
+    // the freeze this frame reflects the state the client reported last frame.
+    SyncInventoryState(context,
+                       (CKInputManager *)context->GetManagerByGuid(INPUT_MANAGER_GUID));
+    ++m_Publishes;
+
+    // Diagnostic: which cameras exist, where they are, and which one the engine
+    // is drawing from. The gameplay camera is scripted, so its name is not
+    // something the code can assume -- this is how it gets identified.
+    if (env_flag("BALLANCE_MC_CAMERA_LIST") && (m_Frame % 120) == 1) {
+        const CKCamera *attached = renderContext->GetAttachedCamera();
+        const XObjectPointerArray cameras = context->GetObjectListByType(CKCID_CAMERA, TRUE);
+        log_line("%d camera object(s), ball=(%.1f %.1f %.1f)", (int)cameras.Size(),
+                 header.Ball[0], header.Ball[1], header.Ball[2]);
+        const XObjectPointerArray all = context->GetObjectListByType(CKCID_3DENTITY, TRUE);
+        int ballLike = 0;
+        for (CKObject **it = all.Begin(); it != all.End(); ++it) {
+            CK3dEntity *each = (CK3dEntity *)*it;
+            if (!each || !name_is_ball(each->GetName())) continue;
+            const VxBbox box = each->GetBoundingBox(FALSE);
+            VxVector pos(0.0f, 0.0f, 0.0f);
+            each->GetPosition(&pos);
+            ++ballLike;
+            log_line("  ball-like \"%s\" pos=(%.1f %.1f %.1f) size=(%.1f %.1f %.1f) vis=%d%s",
+                     each->GetName(), pos.x, pos.y, pos.z,
+                     box.GetSize().x, box.GetSize().y, box.GetSize().z,
+                     each->IsVisible() ? 1 : 0,
+                     each == m_Ball ? "  <== tracked" : "");
+        }
+        if (!ballLike) log_line("  no ball-like 3d entity in the list");
+        for (CKObject **it = cameras.Begin(); it != cameras.End(); ++it) {
+            CKCamera *each = (CKCamera *)*it;
+            if (!each) continue;
+            VxVector pos(0.0f, 0.0f, 0.0f);
+            each->GetPosition(&pos);
+            VxVector dir(0.0f, 0.0f, 1.0f);
+            VxVector up(0.0f, 1.0f, 0.0f);
+            each->GetOrientation(&dir, &up);
+            log_line("  camera \"%s\" pos=(%.1f %.1f %.1f) dir=(%+.2f %+.2f %+.2f) fov=%.1f%s",
+                     each->GetName() ? each->GetName() : "(unnamed)",
+                     pos.x, pos.y, pos.z, dir.x, dir.y, dir.z,
+                     each->GetFov() * kRadiansToDegrees,
+                     each == attached ? "  <== attached" : "");
+        }
+    }
+
+    m_LogTimer += deltaSeconds;
+    if (m_LogTimer < 0.0f) m_LogTimer = 0.0f;
+    if (m_Publishes == 1 || m_LogTimer >= kLogIntervalSeconds) {
+        m_LogTimer = 0.0f;
+        log_line("camera=%s eye=(%.1f %.1f %.1f) dir=(%+.2f %+.2f %+.2f) fov=%.1f deg %ux%u ball=(%.1f %.1f %.1f) frames=%llu%s",
+                 (camera && camera->GetName()) ? camera->GetName() : "(none)",
+                 header.Eye[0], header.Eye[1], header.Eye[2],
+                 header.Forward[0], header.Forward[1], header.Forward[2],
+                 header.FovY * kRadiansToDegrees, header.Width, header.Height,
+                 header.Ball[0], header.Ball[1], header.Ball[2],
+                 (unsigned long long)m_Publishes,
+                 (header.Flags & MPC_FLAG_BALL) ? "" : " (no ball)");
+    }
+}
diff --git a/src/MinecraftCameraSync.h b/src/MinecraftCameraSync.h
new file mode 100644
index 0000000..0152398
--- /dev/null
+++ b/src/MinecraftCameraSync.h
@@ -0,0 +1,125 @@
+#ifndef PLAYER_MINECRAFTCAMERASYNC_H
+#define PLAYER_MINECRAFTCAMERASYNC_H
+
+#include "CKAll.h"
+
+#include "MpCamera.h"
+
+class CMinecraftSettings;
+
+// One time-scale owner shared by the settings panel and the inventory overlay.
+//
+// Both want the level standing still, and both used to save/restore the time
+// scale factor themselves -- which breaks the moment they nest: the second one
+// saves a scale of 0, and closing it restores 0 with the first one still open.
+// The gate counts the reasons instead, freezes on the first and restores the
+// scale it saved when the last one lets go.
+//
+// Freezing is a time scale of 0, not CKContext::Pause(): a paused context stops
+// ExecuteManagersPreProcess, and the SDL input manager is a pre-process manager,
+// so no pointer or key event would arrive to close the overlay again. (Measured
+// in the panel: with the pause in place, a click produced no press at all.)
+class CMinecraftPauseGate
+{
+public:
+    enum Key
+    {
+        ePanel = 1u,
+        eInventory = 2u,
+    };
+
+    // Idempotent: call it every frame with the current wish, and it re-asserts
+    // the freeze if a level script put the time scale back.
+    static void Set(CKContext *context, unsigned key, bool paused);
+    static bool Held(unsigned key);
+    static bool Paused();
+};
+
+// Publishes the viewpoint the frame is about to be rendered from, plus the player
+// ball position, into the camera channel described by MpCamera.h (milestone M1 of
+// the Ballance <-> Minecraft passthrough).
+//
+// This is the reverse direction of the frame mailbox: pixels travel Minecraft ->
+// Ballance, the viewpoint travels Ballance -> Minecraft. The Minecraft client uses
+// it to place its own camera, so after the passthrough is switched on the two
+// images are views of the same place, not two unrelated pictures.
+//
+// Since M1b the same object also carries the input mirror (pointer, buttons,
+// wheel, the E and Escape presses) and the aim lift, and the Minecraft side
+// writes back whether the inventory it opened is still on screen -- that back
+// channel decides whether this side freezes the level and shows the pointer.
+//
+// Off unless BALLANCE_MC_CAMERA=1; the mapping is created on first use and never
+// blocks the render thread. Nothing here is on the frame's critical path when the
+// feature is off: the cost is one environment lookup at construction.
+class CMinecraftCameraSync
+{
+public:
+    CMinecraftCameraSync();
+    ~CMinecraftCameraSync();
+
+    void SetSettings(CMinecraftSettings *settings) { m_Settings = settings; }
+
+    // Called once per rendered frame, before CGamePlayer::Render() draws.
+    void Frame(CKContext *context, CKRenderContext *renderContext, float deltaSeconds);
+    void Shutdown();
+
+    // Test hook: BALLANCE_MC_CAMERA_FAKE_GUI=1 pretends the Minecraft inventory
+    // is on screen, so the freeze can be exercised without a Minecraft client.
+    bool InventoryOpen() const { return m_InventoryOpen; }
+
+private:
+    bool Initialise();
+    void Release();
+    void ResolvePath();
+    void FindBall(CKContext *context);
+    bool BallAlive(CKContext *context);
+    void Publish(const MpCameraHeader &header);
+    void PublishInput(CKContext *context, CKRenderContext *renderContext, MpCameraHeader &header);
+    void SyncInventoryState(CKContext *context, CKInputManager *input);
+    float AimLiftRadians() const;
+
+    bool m_Enabled = false;
+    bool m_Initialised = false;
+    bool m_Mapped = false;
+    bool m_ReportedError = false;
+
+    // POSIX: descriptor of the shm object; Windows: file handle and section.
+    int m_Fd = -1;
+    void *m_FileHandle = nullptr;
+    void *m_Section = nullptr;
+    MpCameraHeader *m_Header = nullptr;
+    MpClientStatus *m_Status = nullptr;
+
+    char m_Path[512] = {};
+    char m_ShmName[128] = {};
+
+    uint32_t m_Seq = 0;
+    uint32_t m_Frame = 0;
+
+    CK_ID m_BallId = 0;
+    CK3dEntity *m_Ball = nullptr;
+    // Viewpoint of the frame being published; FindBall needs it to tell the
+    // player ball apart from the pickups parked at the origin.
+    VxVector m_Eye = VxVector(0.0f, 0.0f, 0.0f);
+    VxVector m_Forward = VxVector(0.0f, 0.0f, 1.0f);
+
+    CMinecraftSettings *m_Settings = nullptr;
+
+    // Input mirror state: the two keys are edge-detected here and counted, so a
+    // press that starts and ends inside one frame is not lost (the panel learned
+    // the same lesson: SDL can deliver both events before the frame polls).
+    bool m_EDown = false;
+    bool m_EscDown = false;
+    uint32_t m_KeyE = 0;
+    uint32_t m_KeyEsc = 0;
+    int32_t m_Wheel = 0;
+
+    bool m_InventoryOpen = false;
+    const char *m_LastInventoryLog = nullptr;
+
+    float m_LogTimer = -1.0f;
+    uint64_t m_Publishes = 0;
+};
+
+#endif // PLAYER_MINECRAFTCAMERASYNC_H
