@@ -0,0 +1,98 @@
+#ifndef PLAYER_MINECRAFTSETTINGS_H
+#define PLAYER_MINECRAFTSETTINGS_H
+
+#include "XString.h"
+
+// The rows a player may change, in panel order. One enum feeds the three places
+// that must not drift apart: the Minecraft.ini keys, the environment variables
+// that override them, and the rows CMinecraftOverlay draws.
+enum McSettingRow
+{
+    eMcSteve = 0,   // Steve=0           draw Steve's body in the level at all
+    eMcFollowBall,  // FollowBall=1      walk with the ball instead of standing still
+    eMcFirstPerson, // FirstPerson=0     camera at Steve's eyes
+    eMcHideSteve,   // HideSteve=0       keep the model, do not draw it
+    eMcHideBall,    // HideBall=0        hide the ball so only Steve is left
+    eMcScale,       // Scale=0.25        Ballance units per model unit
+    eMcSensitivity, // Sensitivity=0.0025 radians of yaw/pitch per mouse pixel
+    eMcAimLift,     // AimLift=8         degrees the Minecraft camera is tilted up over the view
+    eMcDebugLog,    // Debug=0           once a second, log what Steve is doing
+    eMcRowCount
+};
+
+// Steve's user-facing options, in their own file so the panel can write them
+// without ever touching the engine's Player.ini.
+//
+// Two sources, in priority order:
+//
+//   environment variable -- this run only, for scripts and the screenshot
+//                           harnesses, which set the names they always did
+//   Minecraft.ini        -- the persistent default, written by the panel
+//
+// The environment wins, so no existing script changes behaviour; the panel marks
+// a row the environment has taken over, because otherwise a click that changes
+// nothing on screen reads as a broken button.
+class CMinecraftSettings
+{
+public:
+    struct Values
+    {
+        bool steve;
+        bool followBall;
+        bool firstPerson;
+        bool hideSteve;
+        bool hideBall;
+        bool debugLog;
+        float scale;
+        float sensitivity;
+        // Degrees the Minecraft camera is tilted up over the Ballance view
+        // direction. The passthrough overlays one image on the other, so 0 puts
+        // the Minecraft crosshair exactly on the ball and a block placed there
+        // lands on it; this moves the crosshair off the ball without moving the
+        // Ballance frame. See MpCamera.h (AimLift).
+        float aimLift;
+    };
+
+    CMinecraftSettings();
+
+    // Called with the resolved Player.ini path; Minecraft.ini sits beside it, so
+    // one game directory holds one set of settings.
+    void SetFromPlayerIni(const char *playerIniPath);
+
+    const char *GetPath() const { return m_Path.CStr(); }
+
+    // Reads Minecraft.ini if it is there, then applies the environment on top.
+    // A missing file is not an error: the defaults are used and written out.
+    bool Load();
+    bool Save();
+
+    const Values &Get() const { return m_Values; }
+    void Set(const Values &values) { m_Values = values; }
+
+    // Panel access, by row: booleans toggle, numbers step.
+    static bool IsBoolRow(int row);
+    bool GetBool(int row) const;
+    void SetBool(int row, bool value);
+    float GetFloat(int row) const;
+    void SetFloat(int row, float value);
+    void StepFloat(int row, int steps);
+    static const char *GetLabel(int row);
+    static const char *GetKeyName(int row);
+    static const char *GetEnvironmentName(int row);
+    bool IsEnvironmentLocked(int row) const;
+
+    static Values Defaults();
+
+    // Panel action: back to the shipped values, with the environment re-applied
+    // on top so a harness that pinned a row keeps its pin.
+    void ResetToDefaults();
+
+private:
+    void ApplyEnvironment();
+
+    Values m_Values;
+    bool m_EnvLocked[eMcRowCount];
+    XString m_Path;
+};
+
+#endif // PLAYER_MINECRAFTSETTINGS_H
