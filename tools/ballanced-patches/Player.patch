@@ -0,0 +1,86 @@
+#ifndef PLAYER_MINECRAFTSTEVE_H
+#define PLAYER_MINECRAFTSTEVE_H
+
+#include "CKAll.h"
+
+#include <map>
+
+// Puts Minecraft's Steve *inside* the Ballance world.
+//
+// The 2026-11-05 verdict was that the M0/M0b compositing pipeline had the
+// direction backwards: it painted a whole Minecraft frame over the Ballance
+// scene, so the world on screen was Minecraft's. What was wanted is the other
+// way round -- the Ballance world stays the world, and Steve stands in it.
+//
+// So this builds a plain CK2 mesh (six boxes on the classic 64x32 skin atlas),
+// gives it to a CK3dEntity, and drops that entity into the current scene. It is
+// therefore depth tested, lit and fogged by the game's own 3D pass: the pillars
+// occlude Steve exactly as they occlude the track. No shared memory, no
+// reprojection, no rasterizer hooks.
+//
+// Environment:
+//   BALLANCE_MC_STEVE=1        enable (default off)
+//   BALLANCE_MC_STEVE_POS=x,y,z  fixed feet position in Ballance units
+//   BALLANCE_MC_STEVE_BALL=0   do not follow the ball entity, stay at POS
+//   BALLANCE_MC_STEVE_YAW=deg  fixed yaw, overrides the ball heading
+//   BALLANCE_MC_STEVE_SCALE=f  Ballance units per model unit (default 1)
+//   BALLANCE_MC_STEVE_FP=1     park the camera at Steve's eyes
+//   BALLANCE_MC_STEVE_DEBUG=1  once a second, log what it found and where it is
+class CMinecraftSteve {
+public:
+    CMinecraftSteve();
+    ~CMinecraftSteve();
+
+    // Everything happens on the render thread, once per drawn frame.
+    void Frame(CKContext *context, CKRenderContext *renderContext, float deltaSeconds);
+    void Shutdown(CKContext *context);
+
+    bool Enabled() const { return m_Enabled; }
+
+private:
+    bool ReadEnvironment();
+    bool Build(CKContext *context);
+    void UpdatePlacement(CKContext *context, float deltaSeconds);
+    void FindBall(CKContext *context, float deltaSeconds);
+    void ApplyFirstPersonCamera(CKRenderContext *renderContext);
+    void ApplyOffsetCamera(CKRenderContext *renderContext);
+    void DebugLog(CKContext *context, float deltaSeconds);
+
+    bool m_Enabled;
+    bool m_Built;
+    bool m_FirstPerson;
+    bool m_UseFixedPosition;
+    bool m_FollowBall;
+    bool m_Debug;
+    bool m_YawGiven;
+    bool m_LogPending;
+    bool m_DebugTimerReady;
+    bool m_BuildFailed;
+    bool m_Hide;
+    bool m_HideBall;
+    bool m_HasCamOffset;
+
+    VxVector m_CamOffset;
+
+    float m_Scale;
+    float m_FixedYaw;
+    VxVector m_FixedPosition;
+    float m_Yaw;
+    float m_LogTimer;
+    float m_BallScanTimer;
+    std::map<CK3dEntity *, VxVector> m_LastPositions;
+
+    CKMesh *m_Mesh;
+    CK3dEntity *m_Entity;
+    CK3dEntity *m_Ball;
+    CKCamera *m_Camera;
+    CKTexture *m_Texture;
+    CKMaterial *m_Material;
+
+    // Half extent of the model in Ballance units, used to place the feet and
+    // to report a height that can be compared against the ball.
+    float m_Height;
+    float m_EyeHeight;
+};
+
+#endif // PLAYER_MINECRAFTSTEVE_H
