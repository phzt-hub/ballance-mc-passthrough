+      m_LeftDown(false), m_F1Down(false), m_EscapeDown(false),
+      m_OpenedByTest(false), m_HoverRow(-1), m_HoverButton(0), m_Dirty(false), m_Scale(1.0f),
+      m_CellWidth(8.0f), m_CellHeight(12.0f), m_PanelLeft(0.0f), m_PanelTop(0.0f),
+      m_PanelRight(0.0f), m_PanelBottom(0.0f), m_Elapsed(0.0f), m_PointerStamp(-1.0f)
+{
+    for (int i = 0; i < eMcRowCount; ++i)
+    {
+        m_Rows[i].valid = false;
+        m_Minus[i].valid = false;
+        m_Plus[i].valid = false;
+    }
+    m_Reset.valid = false;
+    m_Close.valid = false;
+}
