{
	"schemaVersion": 1,
	"id": "ballance_passthrough",
	"version": "${version}",
	"name": "Ballance Passthrough",
	"description": "Client half of the Ballance <-> Minecraft passthrough: exports every rendered frame into the Ballance frame mailbox (milestone M0b).",
	"authors": [
		"phzt"
	],
	"contact": {
		"homepage": "https://github.com/phzt/ballance-mc-passthrough"
	},
	"license": "CC0-1.0",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.example.ballance.passthrough.PassthroughClient"
		]
	},
	"mixins": [
		{
			"config": "ballance_passthrough.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25"
	}
}
